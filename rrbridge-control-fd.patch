diff --git a/librrprotocol/bridge.ipc.c b/librrprotocol/bridge.ipc.c
new file mode 100644
index 0000000..5bcb12a
--- /dev/null
+++ b/librrprotocol/bridge.ipc.c
@@ -0,0 +1,22 @@
+#include <librrprotocol/bridge.ipc.h>
+#include <errno.h>
+#include <string.h>
+#include <sys/socket.h>
+void rrp_bridge_ipc_init(rrp_bridge_ipc_message_t *m, uint32_t type) {
+   memset(m, 0, sizeof(*m));
+   m->magic = RRP_BRIDGE_IPC_MAGIC;
+   m->version = RRP_BRIDGE_IPC_VERSION;
+   m->type = type;
+}
+bool rrp_bridge_ipc_send(int fd, const rrp_bridge_ipc_message_t *m) {
+   return fd >= 0 && m && send(fd, m, sizeof(*m), MSG_NOSIGNAL | MSG_DONTWAIT) == (ssize_t)sizeof(*m);
+}
+int rrp_bridge_ipc_recv(int fd, rrp_bridge_ipc_message_t *m) {
+   if (fd < 0 || !m) return -1;
+   ssize_t n = recv(fd, m, sizeof(*m), MSG_DONTWAIT | MSG_TRUNC);
+   if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return 0;
+   if (n != (ssize_t)sizeof(*m) || m->magic != RRP_BRIDGE_IPC_MAGIC || m->version != RRP_BRIDGE_IPC_VERSION) return -1;
+   if (!memchr(m->name, 0, sizeof(m->name)) || !memchr(m->driver, 0, sizeof(m->driver)) ||
+       !memchr(m->rx_modes, 0, sizeof(m->rx_modes)) || !memchr(m->tx_modes, 0, sizeof(m->tx_modes))) return -1;
+   return 1;
+}
diff --git a/librrprotocol/bridge.ipc.h b/librrprotocol/bridge.ipc.h
new file mode 100644
index 0000000..961cdec
--- /dev/null
+++ b/librrprotocol/bridge.ipc.h
@@ -0,0 +1,27 @@
+/* Private local bridge control channel. One SOCK_SEQPACKET record per message. */
+#ifndef RRPROTOCOL_BRIDGE_IPC_H
+#define RRPROTOCOL_BRIDGE_IPC_H
+#include <stdbool.h>
+#include <stdint.h>
+#define RRP_BRIDGE_IPC_MAGIC 0x52524231u
+#define RRP_BRIDGE_IPC_VERSION 1u
+#define RRP_BRIDGE_IPC_FD 3
+#define RRP_BRIDGE_IPC_HELLO 1u
+#define RRP_BRIDGE_IPC_CAPABILITIES 2u
+#define RRP_BRIDGE_IPC_SHUTDOWN 3u
+#define RRP_BRIDGE_IPC_MAX 512u
+/* Fixed layout intentionally versioned; local, same-build bridge only. */
+typedef struct rrp_bridge_ipc_message {
+   uint32_t magic, version, type, reserved;
+   char name[64];
+   char driver[64];
+   uint32_t flags; /* bit 0 RX, 1 TX, 2 RX audio, 3 IQ, 4 waterfall, 5 TX audio */
+   uint32_t reserved2;
+   uint64_t rx_min_hz, rx_max_hz, tx_min_hz, tx_max_hz;
+   char rx_modes[96], tx_modes[96];
+} rrp_bridge_ipc_message_t;
+/* Nonblocking receive returns 1=message, 0=no message, -1=error/EOF. */
+int rrp_bridge_ipc_recv(int fd, rrp_bridge_ipc_message_t *msg);
+bool rrp_bridge_ipc_send(int fd, const rrp_bridge_ipc_message_t *msg);
+void rrp_bridge_ipc_init(rrp_bridge_ipc_message_t *msg, uint32_t type);
+#endif
