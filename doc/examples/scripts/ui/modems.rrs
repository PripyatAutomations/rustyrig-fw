ui.add(dict {kind="panel";id="modems";label="Modems";});
ui.add(dict {kind="list";id="slots";parent="modems";label="Modem slots";height_rows=8;action="select";});
ui.add(dict {kind="entry";id="engine";parent="modems";label="Engine (psk / olivia / ft8)";max_length=15;});
ui.add(dict {kind="entry";id="source";parent="modems";label="Audio source (routing ID)";max_length=63;});
ui.add(dict {kind="entry";id="option";parent="modems";label="Mode / tones";max_length=23;});
ui.add(dict {kind="entry";id="value";parent="modems";label="Carrier / bandwidth Hz";max_length=8;});
ui.add(dict {kind="row";id="controls";parent="modems";layout="flow";});
ui.add(dict {kind="button";id="start";parent="controls";label="Start";action="start";});
ui.add(dict {kind="button";id="stop";parent="controls";label="Stop";action="stop";});
ui.add(dict {kind="button";id="route";parent="controls";label="Set RX source";action="route";});
ui.add(dict {kind="button";id="refresh";parent="controls";label="Refresh";action="refresh";});
ui.add(dict {kind="button";id="decoder";parent="controls";label="Open decoder";action="decoder";});
ui.add(dict {kind="checkbox";id="tx";parent="modems";label="TX enabled (requires audio/PTT wires)";action="tx";});
ui.add(dict {kind="list";id="decoded";parent="modems";label="Received text";height_rows=6;expand_y=true;});
ui.add(dict {kind="entry";id="text";parent="modems";label="Transmit text (Enter)";max_length=255;action="send";});
ui.add(dict {kind="button";id="send";parent="modems";label="Send";action="send";});
ui.add(dict {kind="label";id="message";parent="modems";label="";max_length=256;});
