// Set root value to "enabled" to show alongside the VFO.
// Actions beginning with / dispatch through the normal client command parser.
ui.add(dict { kind="panel"; id="tools"; label="Tools"; value="disabled"; });
ui.add(dict { kind="button"; id="scripts"; parent="tools"; label="Script manager"; action="/script"; });
ui.add(dict { kind="button"; id="help"; parent="tools"; label="Help"; action="/help"; });
