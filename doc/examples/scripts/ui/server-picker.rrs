ui.add(dict { kind="button"; id="connect"; parent="actions"; label="Select / Connect"; action="connect"; });
ui.add(dict { kind="button"; id="disconnect"; parent="actions"; label="Disconnect"; action="disconnect"; });
ui.add(dict { kind="button"; id="new"; parent="actions"; label="New server"; action="new"; });
ui.add(dict { kind="button"; id="edit"; parent="actions"; label="Edit server"; action="edit"; });
ui.add(dict { kind="button"; id="refresh"; parent="actions"; label="Refresh"; action="refresh"; });
ui.add(dict { kind="button"; id="cancel"; parent="actions"; label="Cancel"; action="cancel"; });
ui.add(dict { kind="button"; id="delete"; parent="actions"; label="Delete server"; action="delete"; });
ui.add(dict { kind="button"; id="keys"; parent="actions"; label="Manage Certificates"; action="keys"; });
ui.add(dict { kind="button"; id="groups"; parent="actions"; label="Server Groups"; action="groups"; });
ui.add(dict { kind="button"; id="proxies"; parent="actions"; label="Manage Proxies"; action="proxies"; });
ui.add(dict { kind="label"; id="message"; parent="servers"; label=""; });
