ui.add(dict {kind="panel";id="directory";label="SDR Directory";});
ui.add(dict {kind="entry";id="search";parent="directory";label="Search (Enter to filter)";max_length=127;action="filter";});
ui.add(dict {kind="row";id="filters";parent="directory";layout="flow";});
ui.add(dict {kind="checkbox";id="available";parent="filters";label="Available";action="filter";});
ui.add(dict {kind="checkbox";id="connected";parent="filters";label="Connected";action="filter";});
ui.add(dict {kind="checkbox";id="favorites";parent="filters";label="Favorites";action="filter";});
ui.add(dict {kind="checkbox";id="proxy";parent="filters";label="Proxy bridge";action="filter";});
ui.add(dict {kind="label";id="summary";parent="directory";label="";max_length=512;});
ui.add(dict {kind="list";id="receivers";parent="directory";label="Receivers (Enter to connect/disconnect)";expand_y=true;action="connect";});
ui.add(dict {kind="row";id="actions";parent="directory";layout="flow";});
ui.add(dict {kind="button";id="connect";parent="actions";label="Connect/Disconnect";action="connect";});
ui.add(dict {kind="button";id="info";parent="actions";label="Info";action="info";});
ui.add(dict {kind="button";id="favorite";parent="actions";label="Favorite";action="favorite";});
ui.add(dict {kind="button";id="mark";parent="actions";label="Mark";action="mark";});
ui.add(dict {kind="button";id="refresh";parent="actions";label="Refresh";action="refresh";});
ui.add(dict {kind="button";id="reset";parent="actions";label="Reset";action="reset";});
ui.add(dict {kind="label";id="message";parent="directory";label="";max_length=512;});
