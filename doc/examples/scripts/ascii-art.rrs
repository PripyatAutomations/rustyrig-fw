// IRC color-art collector and playback example.
//
// Install in ~/.config/rustyrig/scripts/autoload/ascii-art.rrs
// Type /artwork to open the script-created manager.
//
// A colored line starts a capture. Only artwork lines from the same nick
// and channel extend it. A normal line ends it, or 3.5 seconds of silence.
// Six artwork lines are required. Indexed colors (Ctrl+C) AND RGB hex
// colors (Ctrl+D plus six hex digits), and Unicode block graphics are preserved.

event irc.privmsg {
    if (string.regex(event.room, "^[#&]")) {
        char key = "artwork.capture-" + string.hash(event.room + "|" + event.nick)
        char line = event.text
        bool colored = string.regex(line, string.chr(3) + "[0-9]{1,2}") ||
                       string.regex(line, string.chr(4) + "[0-9A-Fa-f]{6}") ||
                       string.regex(line, "[█▄▀▌▐░▒▓▖▗▘▙▚▛▜▝▞▟]")
        char body = state.get(key + ".body")

        if (colored) {
            if (body == null) {
                state.set(key + ".body", "")
                state.set(key + ".count", 0)
                state.set(key + ".filename",
                    string.slug(string.slice(event.room, 1)) + "-" +
                    string.slug(event.nick) + "-" + time.stamp() + ".mac")
            }
            // Bound memory, not line count. Discard overlarge bursts rather
            // than saving a partial macro.
            if (string.length(state.get(key + ".body")) + string.length(line) < 262144) {
                state.set(key + ".body", state.get(key + ".body") + line + "\n")
                state.set(key + ".count", state.get(key + ".count") + 1)
                timer.after(key, 3500)
            } else {
                state.set(key + ".count", -1000000)
                timer.after(key, 3500)
            }
        } else if (body != null) {
            timer.after(key, 1)
        }
    }
}

// One-shot timer: commit the completed burst, then clear its state.
event ui.timer {
    if (string.regex(event.id, "^artwork[.]capture-")) {
        char body = state.get(event.id + ".body")
        if (body != null) {
            if (state.get(event.id + ".count") >= 6) {
                char dir = env.data_dir() + "/rustyrig/artwork"
                file.mkdir(dir)
                char name = state.get(event.id + ".filename")
                char dest = dir + "/" + name
                if (file.exists(dest)) {
                    dest = dir + "/" + string.slice(name, 0, string.length(name) - 4) + "-2.mac"
                }
                if (file.exists(dest)) {
                    dest = dir + "/" + string.slice(name, 0, string.length(name) - 4) + "-3.mac"
                }
                // Never overwrite an existing artwork.
                if (file.exists(dest) == false) {
                    file.write(dest, body)
                }
            }
            state.set(event.id + ".body", null)
            state.set(event.id + ".count", null)
            state.set(event.id + ".filename", null)
        }
    }
    if (event.id == "artwork-play") {
        char body = state.get("artwork.play.body")
        if (body != null && time.now() >= state.get("artwork.play.next")) {
            int cursor = state.get("artwork.play.cursor")
            if (cursor >= string.lines(body)) {
                timer.cancel("artwork-play")
                state.set("artwork.play.body", null)
                ui.set("artwork_status", "Finished sending macro")
            } else {
                char line = string.line(body, cursor)
                if (line == "" || string.length(line) > 400) {
                    // Empty lines are not sent; oversize lines cannot fit an IRC PRIVMSG.
                    state.set("artwork.play.cursor", cursor + 1)
                    if (line != "") {
                        ui.set("artwork_status", "Skipped oversized artwork line")
                    }
                } else {
                    // The first Z lines can use the burst rate. After that,
                    // switch to the sustained rate for the remainder.
                    int sent = state.get("artwork.play.sent")
                    int gap = 1000 * state.get("artwork.play.seconds") /
                              state.get("artwork.play.lines")
                    if (sent < state.get("artwork.play.burst.max")) {
                        gap = 1000 * state.get("artwork.play.burst.seconds") /
                              state.get("artwork.play.burst.lines")
                    }
                    if (gap < 100) { gap = 100 }
                    if (chat.send(state.get("artwork.play.target"), line, "artwork", 0)) {
                        state.set("artwork.play.cursor", cursor + 1)
                        state.set("artwork.play.sent", sent + 1)
                        state.set("artwork.play.next", time.now() + gap)
                        state.set("artwork.play.errors", 0)
                    } else {
                        state.set("artwork.play.errors", state.get("artwork.play.errors") + 1)
                        if (state.get("artwork.play.errors") >= 20) {
                            timer.cancel("artwork-play")
                            chat.cancel("artwork")
                            state.set("artwork.play.body", null)
                            ui.set("artwork_status", "Playback stopped: destination unavailable or queue full")
                        }
                    }
                }
            }
        }
    }
}

script("/artwork", {
    ui.utility("artwork", "IRC Artwork / Macros")
    ui.add("artwork", "column", "artwork_layout", "")
    ui.add("artwork_layout", "row", "artwork_content", "")
    ui.add("artwork_content", "filelist", "artwork_files", "Select a .mac file",
           env.data_dir() + "/rustyrig/artwork|.mac")
    ui.add("artwork_content", "irc-preview", "artwork_preview", "Color preview")
    ui.add("artwork_layout", "row", "artwork_room_row", "")
    ui.add("artwork_room_row", "label", "artwork_room_label", "Send to:")
    ui.add("artwork_room_row", "roomlist", "artwork_target", "Open chat tabs")
    ui.add("artwork_room_row", "button", "artwork_rooms_refresh", "Refresh")
    ui.add("artwork_layout", "row", "artwork_rate_row", "")
    ui.add("artwork_rate_row", "label", "artwork_rate_label", "Sustained: lines / seconds")
    ui.add("artwork_rate_row", "spin", "artwork_rate_lines", "Lines", "1:20:1:1")
    ui.add("artwork_rate_row", "spin", "artwork_rate_seconds", "Seconds", "1:60:1:2")
    ui.add("artwork_layout", "row", "artwork_burst_row", "")
    ui.add("artwork_burst_row", "label", "artwork_burst_label", "Burst: lines / seconds, up to lines")
    ui.add("artwork_burst_row", "spin", "artwork_burst_lines", "Lines", "1:20:1:2")
    ui.add("artwork_burst_row", "spin", "artwork_burst_seconds", "Seconds", "1:60:1:2")
    ui.add("artwork_burst_row", "spin", "artwork_burst_max", "Max lines (0 disables)", "0:100:1:3")
    ui.add("artwork_burst_row", "button", "artwork_save_rate", "Remember")
    ui.add("artwork_layout", "row", "artwork_actions", "")
    ui.add("artwork_actions", "button", "artwork_send", "Send")
    ui.add("artwork_actions", "button", "artwork_stop", "Stop")
    ui.add("artwork_actions", "button", "artwork_edit", "Edit")
    ui.add("artwork_actions", "button", "artwork_refresh", "Refresh files")
    ui.add("artwork_layout", "row", "artwork_file_actions", "")
    ui.add("artwork_file_actions", "entry", "artwork_newname", "Destination .mac filename")
    ui.add("artwork_file_actions", "button", "artwork_rename", "Rename / Move")
    ui.add("artwork_file_actions", "button", "artwork_delete", "Delete")
    ui.add("artwork_file_actions", "check", "artwork_confirm_delete", "Confirm delete", "true")
    ui.add("artwork_layout", "row", "artwork_folder_row", "")
    ui.add("artwork_folder_row", "entry", "artwork_folder", "New folder name")
    ui.add("artwork_folder_row", "button", "artwork_mkdir", "New Folder")
    ui.add("artwork_layout", "label", "artwork_status", "Select artwork and a destination")
    ui.show("artwork")
})

event ui.change {
    if (event.id == "artwork_files") {
        ui.set("artwork_preview", env.data_dir() + "/rustyrig/artwork/" + event.value)
        ui.set("artwork_status", event.value)
    }
    if (event.id == "artwork_target") {
        char key = "artwork.speed." + string.hash(event.value)
        char saved = setting.get(key + ".lines")
        if (saved != null) { ui.set("artwork_rate_lines", saved) }
        saved = setting.get(key + ".seconds")
        if (saved != null) { ui.set("artwork_rate_seconds", saved) }
        saved = setting.get(key + ".burst.lines")
        if (saved != null) { ui.set("artwork_burst_lines", saved) }
        saved = setting.get(key + ".burst.seconds")
        if (saved != null) { ui.set("artwork_burst_seconds", saved) }
        saved = setting.get(key + ".burst.max")
        if (saved != null) { ui.set("artwork_burst_max", saved) }
    }
}

event ui.click {
    if (event.id == "artwork_rooms_refresh") {
        ui.set("artwork_target", "refresh")
    }
    if (event.id == "artwork_refresh") {
        ui.set("artwork_files", "refresh")
    }
    if (event.id == "artwork_send") {
        if (ui.val("artwork_files") == "" || ui.val("artwork_target") == "") {
            ui.message("artwork_missing", "Select artwork", "Choose a file and an open chat tab.")
        } else {
            timer.cancel("artwork-play")
            chat.cancel("artwork")
            char dest = env.data_dir() + "/rustyrig/artwork/" + ui.val("artwork_files")
            state.set("artwork.play.body", file.read(dest))
            state.set("artwork.play.cursor", 0)
            state.set("artwork.play.errors", 0)
            state.set("artwork.play.target", ui.val("artwork_target"))
            state.set("artwork.play.lines", ui.val("artwork_rate_lines"))
            state.set("artwork.play.seconds", ui.val("artwork_rate_seconds"))
            state.set("artwork.play.burst.lines", ui.val("artwork_burst_lines"))
            state.set("artwork.play.burst.seconds", ui.val("artwork_burst_seconds"))
            state.set("artwork.play.burst.max", ui.val("artwork_burst_max"))
            state.set("artwork.play.sent", 0)
            state.set("artwork.play.next", time.now())
            timer.every("artwork-play", 100)
            ui.set("artwork_status", "Sending artwork")
        }
    }
    if (event.id == "artwork_stop") {
        timer.cancel("artwork-play")
        chat.cancel("artwork")
        state.set("artwork.play.body", null)
        ui.set("artwork_status", "Playback stopped")
    }
    if (event.id == "artwork_save_rate") {
        if (ui.val("artwork_target") != "") {
            char key = "artwork.speed." + string.hash(ui.val("artwork_target"))
            setting.set(key + ".lines", ui.val("artwork_rate_lines"))
            setting.set(key + ".seconds", ui.val("artwork_rate_seconds"))
            setting.set(key + ".burst.lines", ui.val("artwork_burst_lines"))
            setting.set(key + ".burst.seconds", ui.val("artwork_burst_seconds"))
            setting.set(key + ".burst.max", ui.val("artwork_burst_max"))
            ui.set("artwork_status", "Saved sustained/burst rates for selected room")
        }
    }
    if (event.id == "artwork_edit") {
        if (ui.val("artwork_files") != "") {
            ui.edit(env.data_dir() + "/rustyrig/artwork/" + ui.val("artwork_files"))
        }
    }
    if (event.id == "artwork_rename") {
        if (ui.val("artwork_files") != "" && ui.val("artwork_newname") != "") {
            char root = env.data_dir() + "/rustyrig/artwork/"
            char dest = root + ui.val("artwork_newname")
            if (file.exists(dest)) {
                ui.message("artwork_exists", "File exists", "Choose a different filename.")
            } else {
                file.rename(root + ui.val("artwork_files"), dest)
                ui.set("artwork_files", "refresh")
                ui.set("artwork_status", "Renamed artwork")
            }
        }
    }
    if (event.id == "artwork_mkdir") {
        if (ui.val("artwork_folder") != "" && !string.regex(ui.val("artwork_folder"), "(^/|[.][.]|\\\\)")) {
            file.mkdir(env.data_dir() + "/rustyrig/artwork/" + ui.val("artwork_folder"))
            ui.set("artwork_files", "refresh")
        }
    }
    if (event.id == "artwork_delete") {
        if (ui.val("artwork_files") != "") {
            if (ui.val("artwork_confirm_delete")) {
                ui.message("artwork_delete_confirm", "Delete artwork?",
                           "Delete the selected file permanently?", "yesno")
            } else {
                file.remove(env.data_dir() + "/rustyrig/artwork/" + ui.val("artwork_files"))
                ui.set("artwork_files", "refresh")
            }
        }
    }
}

event ui.response {
    if (event.id == "artwork_delete_confirm" && event.answer == "yes") {
        file.remove(env.data_dir() + "/rustyrig/artwork/" + ui.val("artwork_files"))
        ui.set("artwork_files", "refresh")
        ui.set("artwork_status", "Artwork deleted")
    }
}

event ui.close {
    if (event.id == "artwork") {
        timer.cancel("artwork-play")
        chat.cancel("artwork")
        state.set("artwork.play.body", null)
    }
}
