// RustyScript: react to generic callsign watch matches. SPDX-License-Identifier: GPL-2.0-only
// Copy to ~/.config/rustyrig/scripts/ and /script load callsign-alert.rrs.
// Events can originate from modems or other future callsign match sources.
event watch.callsign {
    if (event.origin == "modem") {
        // Modem-specific metadata is available to make routing decisions.
        log.info(event.modem + " [" + event.audio_source + "] " +
                 string.str(event.frequency_hz) + " Hz " + event.mode)
    }
    if (event.kind == "own") {
        log.info("My callsign heard: " + event.callsign + " " + event.text)
    } else {
        log.info("Watchlist hit: " + event.callsign + " " + event.text)
    }
}
