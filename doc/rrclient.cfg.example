; .include file loads a required file inline; !include file is optional and continues if absent.
; Include paths are relative to this file and may be nested up to 4 levels deep. Full paths allowed too!
; See rrclient/defconfig.c for options and their descriptions
; Comments can begin with // # or ;   - We now support C style /* */ comments too
; subsys:level -- levels:  audit | crit | warn | info | debug | crazy | blitz
// most settings go in [general] setting, servers are called [server:name] where name is short name for it
// If you need to send bug reports, please set log.level=*:crazy

[general]
; example complex log filters
;log.level=*:info core:warn www.*:info www.parser:crazy ws:debug ws.chat:crazy ws.auth:crazy
;log.level=*:info,ws.*:crazy,http.*:crazy,event:crazy
;log.level=*:debug,ws.chat.*:crazy
;log.level=*:crazy,ws.binframe:debug,event.*:debug
;log.level=*:info,ws.*:debug,ws.binframe:crazy,media.*:crazy
;log.level=*:info
log.level=*:info
log.file=-
;log.file=rrclient.log
path.help-dir=/var/lib/rustyrig/help
path.modules=/usr/lib/rustyrig/modules/rrclient
ui.show-pings=false
ui.full-screen=false
# Divide scroll events by this # to get single-steps
ui.freqentry.scroll-divider=3.0
; Whole GTK interface size in percent; Alt/Ctrl +/- changes it in 10% steps.
ui.gtk.zoom=100
; Scale to window size; maximized/fullscreen is 100%. False keeps manual zoom.
ui.gtk.scale-on-resize=true
; Do we put the VFO at top or bottom of the window?
ui.gtk.vfo-on-top=false
; bottom, top, left, right
ui.gtk.main-tabstrip=bottom
ui.bell.chat=false
; A shortcut held longer than this becomes push-to-talk; shorter presses toggle PTT.
ui.ptt-hold-delay=500
; pause updating vfo-box from CAT events for X ms
ui.vfo.visocity=1000
; show the userlist when connected?
ui.auto-show-userlist=true
ui.userlist-width=220
; Share command/chat history between all room tabs (false keeps one per room).
ui.shared-input-history=true
tui.use-mouse=false
# Top/topic row; fields are expanded from live client state at each redraw.
tui.status-line=${topic} | ${ptt-state} | VFO ${active_vfo}: ${active_freq_khz:---} kHz ${active_mode:---}
tui.room-status-line=${topic} | ${connection}
tui.status-chat=false
# Example: tui.status-line=\C12${window}\O A:${vfo_a_freq_khz:---} B:${vfo_b_freq_khz:---} ${active_ptt:RX}
# If we want to autoconnect to a server, name it here.
server.auto-connect=localhost

# XXX: Get rid of this and just use the negotiated codec list!
audio.test-mode=true
codecs.allowed=pc16 g722 mu16 mu08 opus oggv aacv flac pc1T g72T mu1T mu0T opuT oggT aacT flaT pc1P g72P mu1P mu0P opuP oggP aacP flaP
default.tx.power=50
log.http=false
log.http.crazy=true
log.audio=*:3

; Window placements & options (hidden|minimized|modal|no-hide|raised)
; Size of -1 will avoid resizing the window and let GTK size it
ui.editcfg=640,634@0,27|raised
ui.fm-mode=210,226@436,305|raised|no-hide
ui.main=1075,750@0,27|raised
ui.serverpick=300,222@200,150|raised|modal
ui.userlist=200,241@1046,303raised|modal|no-hide

# Length of time to block CAT updates (in seconds) after a local state change
cat.poll-blocking=1
; CAT PTY symlink for hamlib/rigctl. Tilde expands to the user's home directory.
cat.pty.enable=true
cat.pty.path=./dev/ttyCAT0

#############
# TUI Theme #
#############
; IRC color controls use \C followed by an index and optional ,background index.
theme.bgcolor=\C01
theme.normal=\C15
theme.chans=\C06
theme.clock.digit=\C10
theme.clock.separator=\C14
theme.nicks=\C11
ui.theme.completion=\C10
theme.msg.connected=\C09
theme.msg.offline=\C04
theme.status=\OStatus: \C09${online}\O \C14[\C11${win.title}\C14]
tui.keymap.prev-win=Alt-Left
tui.keymap.next-win=Alt-Right
tui.keymap.ptt=Ctrl-Space
tui.keymap.del-word=Ctrl-W
tui.keymap.del-line=Ctrl-U
tui.keymap.scroll-up=Pgup
tui.keymap.scroll-down=Pgdn

# Fonts are managed by GTK via CSS in this [gtk-css] section.
# NOTE: '#' and ';' start comments; escape them with a backslash when the
# CSS needs a literal one, e.g. an id selector: \#chat-view { ... }

audio.volume.rx=35
; PCM is the initial fallback while testing the compressed codecs.
; Use the RX/TX picker or /rxcodec and /txcodec to change codecs.
; duplicate codecs.allowed removed: use the negotiated list above

[fwdsp]
pcm-hub=true
path=/usr/bin/fwdsp
hangtime=5
recording.path=~/rrclient-recordings/
recording.tx=true
recording.rx=true
recording.buffer-size=524288
recording.codec=flac
recording.codec.modem=flac
log.file=/var/log/fwdsp-cli.log
subproc.max=24

[pipelines]
; Persistent client hardware endpoints: microphone capture and speaker playback.
src.client.dsp0=pulsesrc name=processor-mic client-name=rrclient-mic do-timestamp=true ! \
        audioconvert ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        queue max-size-buffers=8 max-size-time=100000000 leaky=downstream ! \
        appsink name=processor-sink emit-signals=false sync=false max-buffers=5 drop=true
sink.client.dsp0=appsrc name=processor-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        queue max-size-buffers=8 max-size-time=100000000 leaky=downstream ! volume name=processor-vol ! \
        audioconvert ! audioresample ! pulsesink device=default name=processor-speaker client-name=rrclient-speaker sync=false

; Audio direction is relative to the program running fwdsp:
;   *.rx = media received by this program (decode -> local/raw audio)
;   *.tx = media sent by this program (local/raw audio -> encode)
; record-sink is always on the raw S16LE side of the codec.

; Raw signed 16-bit little-endian PCM, 16 kHz mono.
pc16.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

pc16.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; Opus, 16 kHz mono, restricted-lowdelay, 10 ms frames.
opus.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-opus,rate=16000,channels=1,channel-mapping-family=0 ! \
        opusdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

opus.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! opusenc audio-type=generic frame-size=20 bitrate=24000 bitrate-type=cbr ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; AAC-LC, ADTS-framed MPEG-4 AAC, 16 kHz mono, 32 kbit/s.
aacv.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/mpeg,mpegversion=4,stream-format=adts,framed=true,rate=16000,channels=1 ! \
        aacparse ! avdec_aac ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

aacv.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! audioconvert ! audioresample ! \
        audio/x-raw,format=F32LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! avenc_aac bitrate=32000 ! aacparse ! audio/mpeg,mpegversion=4,stream-format=adts,framed=true ! \
        appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! audioconvert ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; AAC tone-test variant.
aacT.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/mpeg,mpegversion=4,stream-format=adts,framed=true,rate=16000,channels=1 ! \
        aacparse ! avdec_aac ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true
aacT.tx=audiotestsrc is-live=true wave=sine freq=600 samplesperbuffer=320 do-timestamp=true ! audioconvert ! audioresample ! audio/x-raw,format=F32LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! avenc_aac bitrate=32000 ! aacparse ! audio/mpeg,mpegversion=4,stream-format=adts,framed=true ! \
        appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! audioconvert ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; G.711 mu-law at 16 kHz.
mu16.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-mulaw,rate=16000,channels=1 ! \
        mulawdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

mu16.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! mulawenc ! audio/x-mulaw,rate=16000,channels=1 ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; G.711 mu-law at 8 kHz.  Recording remains raw 8 kHz S16LE.
mu08.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-mulaw,rate=8000,channels=1 ! \
        mulawdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=8000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

mu08.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! audioresample ! \
        audio/x-raw,format=S16LE,rate=8000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! mulawenc ! audio/x-mulaw,rate=8000,channels=1 ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; Ogg/Vorbis (oggv), 16 kHz mono. Requires ogg and vorbis plugins.
oggv.rx=appsrc name=rx-src is-live=true format=bytes caps=application/ogg ! \
        tee name=encoded-t encoded-t. ! queue max-size-buffers=8 leaky=downstream ! \
        appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true encoded-t. ! \
        queue ! oggdemux ! \
        vorbisdec ! \
        audioconvert ! \
        audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        tee name=t  t. ! \
        queue max-size-buffers=4 leaky=downstream ! \
        appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

oggv.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        tee name=t t. ! \
        queue max-size-buffers=2 leaky=downstream ! \
        audioconvert ! \
        vorbisenc quality=0.3 ! \
        oggmux max-delay=20000000 max-page-delay=20000000 ! \
        tee name=encoded-t encoded-t. ! queue max-size-buffers=8 leaky=downstream ! \
        appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false encoded-t. ! \
        queue max-size-buffers=8 leaky=downstream ! \
        appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true t. ! \
        queue max-size-buffers=4 leaky=downstream ! \
        appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; G.722 wideband ADPCM, 16 kHz mono, 64 kbit/s (GStreamer libav).
g722.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/G722,rate=16000,channels=1 ! \
        avdec_g722 ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

g722.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! avenc_g722 bitrate=64000 ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; Tone variants: same formats, independent 600 Hz test sources on either host.
pc1T.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

pc1T.tx=audiotestsrc is-live=true wave=sine freq=600 do-timestamp=true ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

g72T.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/G722,rate=16000,channels=1 ! \
        avdec_g722 ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

g72T.tx=audiotestsrc is-live=true wave=sine freq=600 samplesperbuffer=160 do-timestamp=true ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! avenc_g722 bitrate=64000 ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

mu1T.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-mulaw,rate=16000,channels=1 ! \
        mulawdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

mu1T.tx=audiotestsrc is-live=true wave=sine freq=600 do-timestamp=true ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! mulawenc ! audio/x-mulaw,rate=16000,channels=1 ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

mu0T.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-mulaw,rate=8000,channels=1 ! \
        mulawdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=8000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

mu0T.tx=audiotestsrc is-live=true wave=sine freq=600 do-timestamp=true ! volume name=tx-vol ! audioresample ! \
        audio/x-raw,format=S16LE,rate=8000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! mulawenc ! audio/x-mulaw,rate=8000,channels=1 ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

opuT.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-opus,rate=16000,channels=1,channel-mapping-family=0 ! \
        opusdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

opuT.tx=audiotestsrc is-live=true wave=sine freq=600 do-timestamp=true ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! opusenc audio-type=generic frame-size=20 bitrate=24000 bitrate-type=cbr ! \
             appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        t. ! queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

oggT.rx=appsrc name=rx-src is-live=true format=bytes caps=application/ogg ! \
        tee name=encoded-t encoded-t. ! queue max-size-buffers=8 leaky=downstream ! \
        appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true encoded-t. ! \
        queue ! oggdemux ! \
        vorbisdec ! \
        audioconvert ! \
        audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        tee name=t  t. ! \
        queue max-size-buffers=4 leaky=downstream ! \
        appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

oggT.tx=audiotestsrc is-live=true wave=sine freq=600 samplesperbuffer=320 do-timestamp=true ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! \
        tee name=t t. ! \
        queue max-size-buffers=2 leaky=downstream ! \
        audioconvert ! \
        vorbisenc quality=0.3 ! \
        oggmux max-delay=20000000 max-page-delay=20000000 ! \
        tee name=encoded-t encoded-t. ! queue max-size-buffers=8 leaky=downstream ! \
        appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false encoded-t. ! \
        queue max-size-buffers=8 leaky=downstream ! \
        appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true t. ! \
        queue max-size-buffers=4 leaky=downstream ! \
        appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; FLAC, 16 kHz mono. Encoded recording can be copied without re-encoding.
flac.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-flac,framed=true ! \
        tee name=encoded-t encoded-t. ! queue max-size-buffers=8 leaky=downstream ! \
        appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true encoded-t. ! \
        queue ! flacparse ! flacdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
         t. ! \
        queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

flac.tx=appsrc name=tx-src is-live=true format=time do-timestamp=true caps=audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! flacenc ! tee name=encoded-t \
        encoded-t. ! queue max-size-buffers=8 leaky=downstream ! appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        encoded-t. ! queue max-size-buffers=8 leaky=downstream ! appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true t. ! \
        queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

flaT.rx=appsrc name=rx-src is-live=true format=time do-timestamp=true caps=audio/x-flac,framed=true ! \
        tee name=encoded-t encoded-t. ! queue max-size-buffers=8 leaky=downstream ! \
        appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true encoded-t. ! \
        queue ! flacparse ! flacdec ! audioconvert ! audioresample ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
         t. ! \
        queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true t. ! queue max-size-buffers=8 leaky=downstream ! audioresample ! audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! appsink name=hub-sink emit-signals=false sync=false max-buffers=5 drop=true

flaT.tx=audiotestsrc is-live=true wave=sine freq=600 samplesperbuffer=320 do-timestamp=true ! volume name=tx-vol ! \
        audio/x-raw,format=S16LE,rate=16000,channels=1,layout=interleaved ! tee name=t \
        t. ! queue max-size-buffers=2 leaky=downstream ! flacenc ! tee name=encoded-t \
        encoded-t. ! queue max-size-buffers=8 leaky=downstream ! appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false \
        encoded-t. ! queue max-size-buffers=8 leaky=downstream ! appsink name=record-encoded-sink emit-signals=false sync=false max-buffers=8 drop=true t. ! \
        queue max-size-buffers=4 leaky=downstream ! appsink name=record-sink emit-signals=false sync=false max-buffers=4 drop=true

; webcam capture: v4l2src frames -> jpeg. Recording currently applies only to
; raw audio record-sink branches.
jpeg.tx=v4l2src device=/dev/video0 ! videoconvert ! video/x-raw,width=640,height=480,framerate=15/1 ! jpegenc quality=70 ! appsink name=tx-sink emit-signals=false sync=false max-buffers=8 drop=false
jpeg.rx=appsrc name=rx-src do-timestamp=1 format=time ! jpegparse ! jpegdec ! videoconvert ! fakesink name=rx-sink sync=false

; Every server.url requires a scheme. Ports are optional: WS 8420, WSS 4420, IRC 6667, IRCS 6697.
; ws://host:8420/ws/ uses WebSocket; wss://host:4420/ws/ uses WebSocket + TLS.
; irc://host:6667 uses IRC; ircs://host:6697 uses IRC + TLS.
; For IRC, server.user is the nickname and server.pass is the optional PASS.
; IPv6 addresses use brackets, e.g. ircs://[::1]:6697.
[server:localhost]
server.enabled=true
server.url=ws://localhost:8420/ws/
;server.url=ws://10.219.1.1:8420/ws/
server.user=admin
server.pass=password
; Optional per-server SOCKS5 proxy; blank inherits the global server.proxy setting.
server.proxy=
; Optional chat rooms to join after login, separated by commas or spaces.
; The server's authoritative rig room is joined automatically by the server.
; Optional rig rooms to join after login, e.g. #rplywv00-rig0,#rplywv00-rig1
autojoin=
;server.user=guest
;server.pass=guest

[server:camp]
server.enabled=true
;server.url=ws://localhost:8420/ws/
server.url=ws://10.219.1.1:8420/ws/
; Optional per-server SOCKS5 proxy; blank inherits the global server.proxy setting.
server.proxy=
; Optional chat rooms to join after login, separated by commas or spaces.
; Optional rig rooms to join after login, e.g. #rplywv00-rig0,#rplywv00-rig1
autojoin=

[gtk-css]
button { font-family: "Sans"; font-size: 11pt; }
label { font-family: "Sans"; font-size: 11pt; }
\#chat-view { font-family: "Monospace"; font-size: 12pt; }
\#log-view { font-family: "Monospace"; font-size: 12pt; }
\#freq-digit, \#freq-digit-button { font-family: "Monospace"; font-size: 12pt; }
; Active VFO row in a rig userlist (docked or detached).
\#room-vfo-row.room-vfo-active { background-color: #600000; color: white; }
.ptt-active   { background: #b00000; color: white; font-weight: bold; }
.ptt-idle     { background: #0a7a0a; color: white; font-weight: bold; }
.ptt-pending  { background: #e6c200; color: black; font-weight: bold; }
.ptt-offline  { background: #555555; color: white; font-weight: bold; }
.ptt-tot      { background: #e07000; color: black; font-weight: bold; }
.conn-active  { background: #0a7a0a; color: white; font-weight: bold; }
.conn-pending { background: #e6c200; color: black; font-weight: bold; }
.conn-idle    { background: #b00000; color: white; font-weight: bold; }

!include /etc/rustyrig/callsign-lookup.cli.cfg

; Where to find loadable modules (the GTK module ships in
; /usr/lib/rustyrig/modules/rrclient on distro packages).
; Modules to load at startup. The name may include .so or not; the value
; is an options string passed to the module (empty is fine).
; Comment the next line out (or run with -T) for the TUI client.
[modules]
rrclient-gtk.so=

; Local serial name -> service bindings; set none to disable an endpoint.
[serial]
ttyCAT0=rig0.cat@38400
;ttyCAT1=rig1.cat@38400
;ttyHOST0=host:ttyHOST0
; Follow the selected rig, delivering its coordinates to a logger:
;ttyGPS0=rig.gps-out@4800
; Or pin a logger to one rig or the station fallback:
;ttyGPS1=rig1.gps-out@4800
;ttyGPS2=station.gps-out@4800
;ttyGPS3=station.gps-in@4800

; Each endpoint defaults to a PTY at ./dev/<name>.
; Use type=serial and a device path for real hardware.
;[serial:ttyCAT1]
;type=pty
;path=./dev/ttyCAT1
;buffer-bytes=8192
;[serial:ttyHOST0]
;buffer-bytes=65536
;[serial:ttyGPS3]
;type=serial
;path=/dev/ttyUSB0
;baud=4800
