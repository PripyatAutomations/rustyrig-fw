--- /dev/null
+++ b/librrprotocol/bridge.sdr.h
@@ -0,0 +1,54 @@
+// Shared receiver-driver ABI. Drivers run inside an isolated rrbridge process.
+#ifndef RRPROTOCOL_BRIDGE_SDR_H
+#define RRPROTOCOL_BRIDGE_SDR_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define RRP_SDR_ABI_VERSION 2u
+
+typedef struct rrp_sdr_host {
+   void (*audio_pcm16)(void *user, const int16_t *samples, size_t count,
+                       unsigned sample_rate);
+   void (*status)(void *user, const char *message);
+   void *user;
+} rrp_sdr_host_t;
+
+/* Hardware capabilities, not authorization or instantaneous availability.
+ * RX/TX must be checked independently. A bridge may report TX even when
+ * rrserver policy forbids it; neither implies permission to transmit.
+ * mode strings use the same space-separated spelling as property.enum.
+ * The caller must not free strings; they remain owned by the driver.
+ */
+typedef struct rrp_sdr_capabilities {
+   bool rx;
+   bool tx;
+   bool rx_audio;
+   bool rx_iq;
+   bool rx_waterfall;
+   bool tx_audio;
+   uint64_t rx_min_hz, rx_max_hz;
+   uint64_t tx_min_hz, tx_max_hz;
+   const char *rx_modes;
+   const char *tx_modes;
+} rrp_sdr_capabilities_t;
+
+typedef struct rrp_sdr_driver {
+   uint32_t abi_version;
+   const char *name;
+   // Each opened receiver has independent state; opaque instance belongs to driver.
+   void *(*create)(const rrp_sdr_host_t *host);
+   void (*destroy)(void *instance);
+   bool (*capabilities)(void *instance, rrp_sdr_capabilities_t *out);
+   // Transport-independent commands; the host owns socket and framing.
+   bool (*tune)(void *instance, uint64_t hz, const char *mode,
+                char *command, size_t capacity);
+   // Incoming WebSocket payload, NOT a raw TCP stream.
+   bool (*receive)(void *instance, const void *frame, size_t length);
+} rrp_sdr_driver_t;
+
+// false = success, matching librustyaxe's module convention.
+bool rrp_sdr_register(const rrp_sdr_driver_t *driver);
+void rrp_sdr_unregister(const rrp_sdr_driver_t *driver);
+const rrp_sdr_driver_t *rrp_sdr_find(const char *name);
+#endif
--- /dev/null
+++ b/librrprotocol/bridge.sdr.c
@@ -0,0 +1,24 @@
+#include "bridge.sdr.h"
+#include <string.h>
+
+// A single driver per isolated rrbridge process. No global device instance.
+static const rrp_sdr_driver_t *registered_driver;
+
+bool rrp_sdr_register(const rrp_sdr_driver_t *driver) {
+   if (!driver || driver->abi_version != RRP_SDR_ABI_VERSION ||
+       !driver->name || !driver->create || !driver->destroy ||
+       !driver->capabilities || !driver->tune || !driver->receive || registered_driver)
+      return true;
+   registered_driver = driver;
+   return false;
+}
+
+void rrp_sdr_unregister(const rrp_sdr_driver_t *driver) {
+   if (registered_driver == driver)
+      registered_driver = NULL;
+}
+
+const rrp_sdr_driver_t *rrp_sdr_find(const char *name) {
+   return registered_driver && name &&
+          strcmp(registered_driver->name, name) == 0 ? registered_driver : NULL;
+}
--- /dev/null
+++ b/rrbridge/module.kiwi.c
@@ -0,0 +1,98 @@
+// KiwiSDR receiver driver: protocol conversion, not WebSocket transport.
+// The generic rrbridge host is responsible for authentication, reconnects,
+// keepalives and forwarding the resulting PCM to librrprotocol media channels.
+#include <librrprotocol/bridge.sdr.h>
+#include <librustyaxe/module.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <inttypes.h>
+
+struct kiwi_instance {
+   rrp_sdr_host_t host;
+};
+
+static void *kiwi_create(const rrp_sdr_host_t *host) {
+   struct kiwi_instance *kiwi;
+   if (!host || !(kiwi = calloc(1, sizeof(*kiwi))))
+      return NULL;
+   kiwi->host = *host;
+   return kiwi;
+}
+
+static void kiwi_destroy(void *instance) {
+   free(instance);
+}
+
+static bool kiwi_capabilities(void *instance, rrp_sdr_capabilities_t *out) {
+   if (!instance || !out) return false;
+   *out = (rrp_sdr_capabilities_t) {
+      .rx = true,
+      .rx_audio = true, // Host transport/decoding is not implemented yet.
+      .rx_waterfall = true,
+      .rx_min_hz = 0,
+      .rx_max_hz = 30000000,
+      .rx_modes = "usb lsb am cw"
+   };
+   return true;
+}
+
+static bool kiwi_tune(void *instance, uint64_t hz, const char *mode,
+                      char *command, size_t capacity) {
+   const char *kiwi_mode = NULL;
+   int n;
+   if (!instance || !mode || !command || !capacity || hz > 30000000)
+      return false;
+   if (!strcmp(mode, "usb")) kiwi_mode = "usb";
+   else if (!strcmp(mode, "lsb")) kiwi_mode = "lsb";
+   else if (!strcmp(mode, "am")) kiwi_mode = "am";
+   else if (!strcmp(mode, "cw")) kiwi_mode = "cw";
+   else return false;
+   // Kiwi's mod command uses kHz, with passband edges in Hz.
+   n = snprintf(command, capacity, "SET mod=%s low_cut=-300 high_cut=2700 freq=%" PRIu64 ".%03" PRIu64,
+                kiwi_mode, hz / 1000, hz % 1000);
+   return n > 0 && (size_t)n < capacity;
+}
+
+static bool kiwi_receive(void *instance, const void *frame, size_t length) {
+   struct kiwi_instance *kiwi = instance;
+   const unsigned char *data = frame;
+   if (!kiwi || (!frame && length))
+      return false;
+   // Kiwi frames are tagged (MSG, SND, W/F). Do not mistake compressed
+   // audio, headers or control messages for raw PCM.
+   if (length >= 3 && memcmp(data, "MSG", 3) == 0) {
+      if (kiwi->host.status) {
+         // MSG is not guaranteed NUL-terminated.
+         char *message = malloc(length + 1);
+         if (!message) return false;
+         memcpy(message, frame, length);
+         message[length] = '\0';
+         kiwi->host.status(kiwi->host.user, message);
+         free(message);
+      }
+      return true;
+   }
+   return false;  // SND and W/F decode intentionally not implemented yet.
+}
+
+static const rrp_sdr_driver_t kiwi_driver = {
+   .abi_version = RRP_SDR_ABI_VERSION,
+   .name = "kiwi",
+   .create = kiwi_create,
+   .destroy = kiwi_destroy,
+   .capabilities = kiwi_capabilities,
+   .tune = kiwi_tune,
+   .receive = kiwi_receive
+};
+
+rr_module_event_t modexports[] = {{0}};
+
+bool rr_module_init(void) {
+   return rrp_sdr_register(&kiwi_driver);
+}
+
+void rr_module_shutdown(void) {
+   rrp_sdr_unregister(&kiwi_driver);
+}
--- /dev/null
+++ b/rrbridge/test.kiwi.c
@@ -0,0 +1,38 @@
+#include <librrprotocol/bridge.sdr.h>
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+extern bool rr_module_init(void);
+extern void rr_module_shutdown(void);
+static void status(void *user, const char *msg) {
+   int *calls = user;
+   assert(strcmp(msg, "MSG hello") == 0);
+   ++*calls;
+}
+int main(void) {
+   int calls = 0;
+   char cmd[128];
+   assert(!rr_module_init());
+   const rrp_sdr_driver_t *driver = rrp_sdr_find("kiwi");
+   assert(driver);
+   rrp_sdr_host_t host = {.status = status, .user = &calls};
+   void *rx = driver->create(&host);
+   assert(rx);
+   rrp_sdr_capabilities_t cap = {0};
+   assert(driver->capabilities(rx, &cap));
+   assert(cap.rx && !cap.tx && cap.rx_audio && !cap.tx_audio);
+   assert(cap.rx_max_hz == 30000000 && cap.tx_max_hz == 0);
+   assert(strcmp(cap.rx_modes, "usb lsb am cw") == 0);
+   assert(cap.tx_modes == NULL);
+   assert(driver->tune(rx, 14200000, "usb", cmd, sizeof(cmd)));
+   assert(strcmp(cmd, "SET mod=usb low_cut=-300 high_cut=2700 freq=14200.000") == 0);
+   assert(!driver->tune(rx, 14200000, "invalid", cmd, sizeof(cmd)));
+   assert(!driver->tune(rx, 14200000, "usb", cmd, 4));
+   assert(driver->receive(rx, "MSG hello", 9));
+   assert(!driver->receive(rx, "SND", 3));
+   assert(calls == 1);
+   driver->destroy(rx);
+   rr_module_shutdown();
+   assert(rrp_sdr_find("kiwi") == NULL);
+   puts("kiwi bridge ABI test: OK");
+}
--- /dev/null
+++ b/rrbridge/rules.mk
@@ -0,0 +1,18 @@
+# KiwiSDR loadable receiver module. Runtime host will be added separately.
+ifeq (${PLATFORM},posix)
+rrbridge_modules := bin/rrbridge-kiwi.so
+bins += ${rrbridge_modules}
+extra_clean += ${BUILD_DIR}/rrbridge/module.kiwi.o ${rrbridge_modules}
+${BUILD_DIR}/rrbridge/module.kiwi.o: rrbridge/module.kiwi.c librrprotocol/bridge.sdr.h ${OBJECT_ORDER_ONLY}
+	@mkdir -p $(dir $@)
+	@${CC} ${CFLAGS} -fPIC -c -o $@ $<
+bin/rrbridge-kiwi.so: ${BUILD_DIR}/rrbridge/module.kiwi.o ${librrprotocol} ${librustyaxe}
+	@mkdir -p bin
+	@${CC} ${LIB_LDFLAGS} -o $@ $< -lrrprotocol -lrustyaxe ${LDFLAGS}
+endif
+
+.PHONY: test-rrbridge-kiwi
+test-rrbridge-kiwi:
+	@mkdir -p ${BUILD_DIR}/rrbridge
+	@${CC} -std=c11 -Wall -Wextra -Werror -I. -o ${BUILD_DIR}/rrbridge/test.kiwi librrprotocol/bridge.sdr.c rrbridge/module.kiwi.c rrbridge/test.kiwi.c
+	@${BUILD_DIR}/rrbridge/test.kiwi
