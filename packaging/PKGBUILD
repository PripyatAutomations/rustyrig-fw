# Build with: makepkg -f
# IMPORTANT: this VCS source follows the main branch; pin a release tag or commit
# for reproducible release packages, and update pkgrel for package revisions.
# Arch Linux split packages; build from the checked-out repository and its submodules.
pkgbase=rustyrig
pkgname=(rustyrig-server-gpsd rustyrig-server-hamlib rustyrig-libs rustyrig-server rustyrig-client rustyrig-client-gtk rustyrig-fwdsp rustyrig-callsign-lookup)
options=('!emptydirs')
pkgver=1.0.0
pkgrel=1
pkgdesc='RustyRig remote radio software'
arch=('x86_64')
url='https://github.com/PripyatAutomations/rustyrig-fw'
license=('MIT')
makedepends=('git' 'make' 'jq' 'pkgconf' 'perl' 'libbsd' 'ncurses' 'sqlite' 'curl' 'hamlib' 'libgpiod' 'glib2' 'gtk3' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'libev' 'libsrtp')
source=('git+https://github.com/PripyatAutomations/rustyrig-fw.git')
sha256sums=('SKIP')

prepare() {
   cd "$srcdir/rustyrig-fw"
   git submodule update --init --recursive
   test "$(cat .version)" = "$pkgver" || warning "PKGBUILD pkgver differs from source .version"
}

build() {
   cd "$srcdir/rustyrig-fw"
   make PROFILE=radio
   make -C callsign-lookup
}

_install_libs() {
   cd "$srcdir/rustyrig-fw"
   install -Dm755 librustyaxe.so "$pkgdir/usr/lib/librustyaxe.so.0"
   install -Dm755 librustyirc.so "$pkgdir/usr/lib/librustyirc.so.0"
   ln -s librustyirc.so.0 "$pkgdir/usr/lib/librustyirc.so"
   install -Dm755 librrprotocol.so "$pkgdir/usr/lib/librrprotocol.so.0"
   install -Dm755 libfwdspmgr.so "$pkgdir/usr/lib/libfwdspmgr.so.0"
   ln -s librustyaxe.so.0 "$pkgdir/usr/lib/librustyaxe.so"
   ln -s librrprotocol.so.0 "$pkgdir/usr/lib/librrprotocol.so"
   ln -s libfwdspmgr.so.0 "$pkgdir/usr/lib/libfwdspmgr.so"
}

package_rustyrig-libs() {
   pkgdesc='RustyRig shared libraries'
   depends=('glib2' 'sqlite' 'libbsd' 'libev' 'libsrtp')
   _install_libs
}

package_rustyrig-server() {
   pkgdesc='RustyRig radio server'; depends=('rustyrig-libs' 'jq' 'sqlite' 'libgpiod' 'shadow' 'acl')
   install=rustyrig.install
   backup=('etc/rustyrig/ua-bans.txt' 'etc/rustyrig/radio.config.json')
   cd "$srcdir/rustyrig-fw"
   install -Dm755 bin/rrserver "$pkgdir/usr/bin/rrserver"
   install -Dm755 bin/rrbridge "$pkgdir/usr/bin/rrbridge"
   install -Dm755 bin/rrbridge-kiwi.so "$pkgdir/usr/lib/rustyrig/modules/rrbridge/rrbridge-kiwi.so"
   install -Dm755 bin/rr-dds-si5351 "$pkgdir/usr/bin/rr-dds-si5351"
   install -Dm755 packaging/admin-permissions.sh "$pkgdir/usr/lib/rustyrig/admin-permissions"
   install -Dm755 bin/rrserver-gps-nmea.so "$pkgdir/usr/lib/rustyrig/modules/rrserver/rrserver-gps-nmea.so"
   install -Dm755 tools/rr-get-audit-log "$pkgdir/usr/bin/rr-get-audit-log"
   install -Dm755 tools/rr-get-chat-log "$pkgdir/usr/bin/rr-get-chat-log"
   install -Dm755 tools/rr-get-ptt-log "$pkgdir/usr/bin/rr-get-ptt-log"
   install -Dm644 packaging/rrserver.service "$pkgdir/usr/lib/systemd/system/rustyrig-server.service"
   install -Dm644 packaging/rustyrig.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/rustyrig.conf"
   for cfg in config/rrserver.cfg config/rrserver.*.cfg; do
      install -Dm644 "$cfg" "$pkgdir/etc/rustyrig/${cfg##*/}"
      backup+=("etc/rustyrig/${cfg##*/}")
   done
   install -Dm644 config/radio.config.json "$pkgdir/etc/rustyrig/radio.config.json"
   install -Dm644 config/ua-bans "$pkgdir/etc/rustyrig/ua-bans.txt"
   install -Dm644 sql/sqlite.master.sql "$pkgdir/var/lib/rustyrig/sql/sqlite.master.sql"
   install -Dm644 sql/sqlite.master.preload.sql "$pkgdir/var/lib/rustyrig/sql/sqlite.master.preload.sql"
   install -Dm755 tools/dummy-rigctld.sh "$pkgdir/var/lib/rustyrig/tools/dummy-rigctld.sh"
   install -d -m0775 "$pkgdir/var/log/rustyrig"
   install -d "$pkgdir/var/lib/rustyrig"/{db,recordings,modems,sql,tools,www}
   find www -mindepth 1 -maxdepth 1 ! -name .git -exec cp -a {} "$pkgdir/var/lib/rustyrig/www/" \;
   install -d "$pkgdir/usr/share/doc/rustyrig"
   cp -a doc/. "$pkgdir/usr/share/doc/rustyrig/"
}

package_rustyrig-client() {
   pkgdesc='RustyRig client'
   backup=('etc/rustyrig/rrclient.cfg' 'etc/rustyrig/callsign-lookup.cli.cfg')
   depends=('rustyrig-libs' 'glib2' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad')
   cd "$srcdir/rustyrig-fw"
   install -Dm755 bin/rrclient "$pkgdir/usr/bin/rrclient"
   install -Dm644 config/rrclient.cfg "$pkgdir/etc/rustyrig/rrclient.cfg"
   install -Dm644 config/callsign-lookup.cli.cfg "$pkgdir/etc/rustyrig/callsign-lookup.cli.cfg"
   install -d "$pkgdir/var/lib/rustyrig"/{db,help,recordings/client} "$pkgdir/var/log/rustyrig"
   find help -mindepth 1 -maxdepth 1 ! -name .git -exec cp -a {} "$pkgdir/var/lib/rustyrig/help/" \;
}

package_rustyrig-client-gtk() {
   pkgdesc='RustyRig GTK client module'
   depends=('rustyrig-client' 'gtk3')
   cd "$srcdir/rustyrig-fw"
   install -Dm755 bin/rrclient-gtk.so "$pkgdir/usr/lib/rustyrig/modules/rrclient/rrclient-gtk.so"
   install -Dm644 packaging/rustyrig-client.desktop "$pkgdir/usr/share/applications/rustyrig-client.desktop"
   install -Dm644 res/rustyrig.png "$pkgdir/usr/share/icons/hicolor/48x48/apps/rustyrig.png"
}
package_rustyrig-fwdsp() {
   pkgdesc='RustyRig GStreamer audio DSP service'; install=rustyrig.install; depends=('rustyrig-libs' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'shadow')
   cd "$srcdir/rustyrig-fw"; install -Dm755 bin/fwdsp "$pkgdir/usr/bin/fwdsp"
}
package_rustyrig-callsign-lookup() {
   pkgdesc='RustyRig callsign lookup service'; backup=('etc/rustyrig/callsign-lookup.cfg'); depends=('rustyrig-libs' 'curl' 'sqlite')
   cd "$srcdir/rustyrig-fw"; install -Dm755 bin/callsign-lookup "$pkgdir/usr/bin/callsign-lookup"; install -Dm644 config/callsign-lookup.cfg "$pkgdir/etc/rustyrig/callsign-lookup.cfg"
}


package_rustyrig-server-gpsd() {
   pkgdesc='GPSD receiver module for RustyRig server'
   depends=('rustyrig-server' 'gpsd')
   cd "$srcdir/rustyrig-fw"
   install -Dm755 bin/rrserver-gpsd.so "$pkgdir/usr/lib/rustyrig/modules/rrserver/rrserver-gpsd.so"
}

package_rustyrig-server-hamlib() {
   pkgdesc='Optional Hamlib backend module for RustyRig server'
   depends=('rustyrig-server' 'hamlib')
   cd "$srcdir/rustyrig-fw"
   install -Dm755 bin/rrserver-hamlib.so "$pkgdir/usr/lib/rustyrig/modules/rrserver/rrserver-hamlib.so"
}
