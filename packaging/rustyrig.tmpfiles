# Keep runtime state directories available for the rrserver service.
d /var/lib/rustyrig 0775 rustyrig rustyrig -
d /var/lib/rustyrig/db 0775 rustyrig rustyrig -
d /var/lib/rustyrig/recordings 0775 rustyrig rustyrig -
d /var/lib/rustyrig/modems 0775 rustyrig rustyrig -
d /var/log/rustyrig 0775 rustyrig rustyrig -
d /run/rustyrig 0775 rustyrig rustyrig -
