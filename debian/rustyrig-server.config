#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_input medium rustyrig/admin-users || true
db_go || true

# Do not ask again on upgrades.  The postinst intentionally preserves the
# password in an existing database.
if [ -e /var/lib/rustyrig/db/master.db ]; then
    exit 0
fi

db_input high rustyrig-server/admin-password || true
db_input high rustyrig-server/enable-guest || true
db_go || true

exit 0
