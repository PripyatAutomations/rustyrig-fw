#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_input medium rustyrig/admin-users || true
db_input medium rustyrig/serial-users || true
db_go || true

# Do not ask again on upgrades.  The postinst intentionally preserves the
# password in an existing database.
if [ -e /var/lib/rustyrig/db/master.db ]; then
    exit 0
fi

# Reask a required password if a previous bootstrap failed before saving it.
if db_get rustyrig-server/admin-password && [ -z "${RET:-}" ]; then
    db_fset rustyrig-server/admin-password seen false || true
fi
db_input high rustyrig-server/admin-password || true
db_input high rustyrig-server/enable-guest || true
db_input high rustyrig-server/allow-remote-admin || true
db_go || true

if db_get rustyrig-server/enable-guest && [ "${RET:-false}" = true ]; then
    if db_get rustyrig-server/guest-password && [ -z "${RET:-}" ]; then
        db_fset rustyrig-server/guest-password seen false || true
    fi
    db_input high rustyrig-server/guest-password || true
    db_go || true
fi

if db_get rustyrig-server/allow-remote-admin && [ "${RET:-false}" = true ]; then
    db_input high rustyrig-server/remote-admin-subjects || true
    db_go || true
fi

exit 0
