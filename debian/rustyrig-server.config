#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_input medium rustyrig/admin-users || true
db_input medium rustyrig/serial-users || true
# Extra access for the rrserver service account is opt-in.
if getent group video >/dev/null 2>&1; then
    db_input medium rustyrig-server/backlight-video-group || true
fi
if getent group dialout >/dev/null 2>&1; then
    db_input medium rustyrig-server/serial-dialout-group || true
fi
db_go || true

# Do not ask again on upgrades.  The postinst intentionally preserves the
# password in an existing database.
if [ -e /var/lib/rustyrig/db/master.db ]; then
    exit 0
fi

db_input high rustyrig-server/admin-password || true
db_input high rustyrig-server/enable-guest || true
db_go || true

exit 0
