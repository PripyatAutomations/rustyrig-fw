#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Site metadata is independent of database bootstrap, and is editable through
# dpkg-reconfigure even on an existing station. Preserve local edits on upgrades.
site_config=/etc/rustyrig/rrserver.site-local.cfg
site_fields="domain name call grid location description"
site_value() {
    [ -r "$site_config" ] || return 0
    key=station.$1
    [ "$1" != domain ] || key=domain
    awk -v key="$key" '
        /^[[:space:]]*\[/ {
            general = ($0 ~ /^[[:space:]]*\[general\][[:space:]]*([;#].*)?$/)
            next
        }
        general {
            pos = index($0, "=")
            if (!pos) next
            name = substr($0, 1, pos - 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            if (name == key) {
                value = substr($0, pos + 1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            }
        }
        END { print value }
    ' "$site_config"
}

db_get rustyrig-server/site-pending || true
site_pending=${RET:-false}
for field in $site_fields; do
    question=rustyrig-server/site-$field
    current=$(site_value "$field")
    if [ "$site_pending" != true ]; then
        # The shipped examples are not a configured station. Do not replace
        # preseeding with these placeholders on a second config invocation.
        case "$field:$current" in
            domain:camp.local|name:dsmiia00|name:rplywv00|call:N0CALL|grid:AA00aa|location:Unknown\ City|description:A\ misconfigured\ server|*:) ;;
            *) db_set "$question" "$current" ;;
        esac
    fi
    db_input high "$question" || true
done
db_go || true
site_pending=false
for field in $site_fields; do
    db_get "rustyrig-server/site-$field" || continue
    current=$(site_value "$field")
    if [ -n "${RET:-}" ] && [ "$RET" != "$current" ]; then
        site_pending=true
    fi
done
db_set rustyrig-server/site-pending "$site_pending" || true

db_input medium rustyrig/admin-users || true
db_input medium rustyrig/serial-users || true
db_go || true

# Do not ask again on upgrades.  The postinst intentionally preserves the
# password in an existing database.
if [ -e /var/lib/rustyrig/db/master.db ]; then
    exit 0
fi

# Reask a required password if a previous bootstrap failed before saving it.
if db_get rustyrig-server/admin-password && [ -z "${RET:-}" ]; then
    db_fset rustyrig-server/admin-password seen false || true
fi
db_input high rustyrig-server/admin-password || true
db_input high rustyrig-server/enable-guest || true
db_input high rustyrig-server/allow-remote-admin || true
db_go || true

if db_get rustyrig-server/enable-guest && [ "${RET:-false}" = true ]; then
    if db_get rustyrig-server/guest-password && [ -z "${RET:-}" ]; then
        db_fset rustyrig-server/guest-password seen false || true
    fi
    db_input high rustyrig-server/guest-password || true
    db_go || true
fi

if db_get rustyrig-server/allow-remote-admin && [ "${RET:-false}" = true ]; then
    db_input high rustyrig-server/remote-admin-subjects || true
    db_go || true
fi

exit 0
