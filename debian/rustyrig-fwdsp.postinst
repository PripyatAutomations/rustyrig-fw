#!/bin/sh
set -e


# DSP workers need to write recordings owned by the RustyRig service account.
if getent group rustyrig >/dev/null; then
    adduser rustyrig-dsp rustyrig >/dev/null 2>&1 || true
fi
if getent group audio >/dev/null; then
    adduser rustyrig-dsp audio >/dev/null 2>&1 || true
fi
if [ -d /var/lib/rustyrig/recordings ]; then
    chown rustyrig:rustyrig /var/lib/rustyrig/recordings
    chmod 0770 /var/lib/rustyrig/recordings
fi

exit 0
