Package: rustyrig-common
Architecture: all
Depends: adduser, acl, ${misc:Depends}
# The helper used to ship inside librustyaxe, before this package split.
Replaces: librustyaxe (<< 1.0.3~)
Description: Common RustyRig administration helpers
 Shared local account, file-permission and administrative helper scripts
 used by the RustyRig server and terminal client.

Package: rustyrig-rrbridge
Architecture: any
Depends: librustyaxe0 (>= 0.1.0-3), ${shlibs:Depends}, ${misc:Depends}
# Bridge host and Kiwi module previously belonged to rustyrig-server and rustyrig-bridge.
Breaks: rustyrig-bridge (<< 1.0.3~)
Replaces: rustyrig-bridge (<< 1.0.3~), rustyrig-server (<< 1.0.3~)
Description: Remote SDR bridge host and KiwiSDR module for RustyRig
 Bridge process and receiver-driver module used for access to remote
 KiwiSDR receivers. Radio servers can install this package to provide
 SDR reception without requiring the GTK client.

Package: rustyrig-server
Architecture: any
Pre-Depends: adduser
Depends: rustyrig-common (= ${binary:Version}), acl, debconf, jq, sqlite3, librrprotocol0 (>= 0.1.0-5), rustyrig-fwdsp (= ${binary:Version}), librustyaxe0, ${shlibs:Depends}, ${misc:Depends}
Recommends: rustyrig-rrbridge (= ${binary:Version}), rustyrig-callsign-lookup (>= 1.0.3)
Suggests: rustyrig-server-hamlib
Description: RustyRig server
 Backend server for remote radio operation.

Package: rustyrig-client
Architecture: any
Pre-Depends: adduser
Depends: rustyrig-common (= ${binary:Version}), librustyirc0, acl, debconf, librrprotocol0 (>= 0.1.0-5), rustyrig-fwdsp (= ${binary:Version}), librustyaxe0 (>= 0.1.0-5), ${shlibs:Depends}, ${misc:Depends}
Recommends: rustyrig-rrbridge (= ${binary:Version}), rustyrig-callsign-lookup (>= 1.0.3)
Suggests: rrclient-screensaver
Description: RustyRig client
 RustyRig client with TUI interface; the GTK interface ships separately
 in rustyrig-client-gtk as a loadable module.

Package: rustyrig-client-gtk
Architecture: any
Depends: rustyrig-client (= ${binary:Version}), extra-xdg-menus, ${shlibs:Depends}, ${misc:Depends}
Description: RustyRig GTK client module
 GTK frontend for the RustyRig client and standalone GStreamer pipeline editor.
 The module is loaded from /usr/lib/rustyrig/modules/rrclient by the core
 client's [modules] configuration.

Package: gmatrix
Architecture: any
Provides: rrclient-screensaver
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: Optional fullscreen GTK screensaver for RustyRig
 Standalone animated screensaver launched from the GTK client with
 Escape followed by grave or tilde. Runs independently of rrclient.

Package: rustyrig-fwdsp
Architecture: any
Pre-Depends: adduser
Depends: librustyaxe0,
 gstreamer1.0-tools, gstreamer1.0-plugins-base,
 gstreamer1.0-plugins-good, gstreamer1.0-pulseaudio,
 gstreamer1.0-plugins-bad,
 ${shlibs:Depends}, ${misc:Depends}
Conflicts: libfwdspmgr (<< 1.0.2-4~), libfwdspmgr-dev (<< 1.0.2-4~)
Replaces: libfwdspmgr (<< 1.0.2-4~), libfwdspmgr-dev (<< 1.0.2-4~)
Description: Rusty Rigs shared audio processing engine
 RustyRig audio processing engine including the fwdsp GStreamer worker,
 the shared DSP pipeline manager library, and development headers.

Package: rustyrig-server-gpsd
Architecture: any
Depends: rustyrig-server (= ${binary:Version}), ${shlibs:Depends}, ${misc:Depends}
Description: GPSD receiver module for RustyRig server
 Optional GPSD connection for station and rig coordinates, installed in
 /usr/lib/rustyrig/modules/rrserver. Enable rrserver-gpsd in [modules].

Package: rustyrig-server-hamlib
Architecture: any
Depends: rustyrig-server (= ${binary:Version}), ${shlibs:Depends}, ${misc:Depends}
Description: Hamlib backend module for RustyRig server
 Optional Hamlib radio backend, installed in
 /usr/lib/rustyrig/modules/rrserver. Loaded when a rig selects backend=hamlib.

Package: rustyrig-modem-ft8
Architecture: any
Depends: rustyrig-server (= ${binary:Version}), ${shlibs:Depends}, ${misc:Depends}
Description: Optional receive-only FT8 modem worker for RustyRig
 Runs as an isolated rig-local subprocess. Uses ft8_lib to decode received
 audio and emit line-oriented JSON or text through the serial modem stream.
 Installs the executable into /var/lib/rustyrig/modems.
 Built only when WITH_FT8=yes and an ft8_lib source tree is available.
