#!/usr/bin/make -f

export DH_VERBOSE = 1
.DEFAULT_GOAL := binary
PROFILE ?= radio
include mk/optional-modules.mk
include mk/install-paths.mk

# FT8 is optional: external ft8_lib is only needed for this binary package.
WITH_FT8 ?= no
FT8_DH_EXCLUDE := $(if $(filter yes true 1,$(WITH_FT8)),,-Nrustyrig-modem-ft8)

# Optional packages are omitted consistently at every debhelper stage.
define optional_install_rule
.PHONY: install-optional-$(1)
install-optional-$(1):
	install -Dm755 $(OPTIONAL_$(1)_ARTIFACT) debian/$(OPTIONAL_$(1)_PACKAGE)/$(OPTIONAL_$(1)_DEST)
endef
$(foreach m,$(ENABLED_OPTIONAL_MODULES),$(eval $(call optional_install_rule,$(m))))

# dpkg-buildpackage exposes requested parallelism as parallel=N.  Direct
# debian/rules invocations remain serial unless that option is supplied.
DEB_BUILD_JOBS = 1
parallel_opt := $(filter parallel=%,$(DEB_BUILD_OPTIONS))
ifneq ($(parallel_opt),)
DEB_BUILD_JOBS = $(patsubst parallel=%,%,$(parallel_opt))
ifeq ($(DEB_BUILD_JOBS),auto)
DEB_BUILD_JOBS = $(shell nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
endif
endif

%:
	dh $@ $(OPTIONAL_DH_EXCLUDES) $(FT8_DH_EXCLUDE)

# Keep package builds independent of the optional hardware/integration test suite.
override_dh_auto_test:
	:

override_dh_auto_clean:
	$(MAKE) distclean || true
	$(MAKE) -C callsign-lookup clean || true
	$(MAKE) -C modems/ft8 clean || true

override_dh_auto_build:
	@echo "Optional modules enabled: $(ENABLED_OPTIONAL_MODULES); skipped: $(DISABLED_OPTIONAL_MODULES)"
	$(MAKE) -j$(DEB_BUILD_JOBS) PROFILE=$(PROFILE) $(OPTIONAL_MAKE_FLAGS)
	$(MAKE) -j$(DEB_BUILD_JOBS) -C callsign-lookup
ifneq ($(filter yes true 1,$(WITH_FT8)),)
	$(MAKE) -C modems/ft8 FT8_LIB=../../ext/ft8_lib
endif

override_dh_auto_install: $(addprefix install-optional-,$(ENABLED_OPTIONAL_MODULES))
	install -Dm755 packaging/admin-permissions.sh debian/librustyaxe/usr/lib/rustyrig/admin-permissions
	install -Dm755 bin/rrbridge debian/rustyrig-server/usr/bin/rrbridge
	install -Dm755 bin/rrbridge-kiwi.so debian/rustyrig-server/usr/lib/rustyrig/modules/rrbridge/rrbridge-kiwi.so
	install -Dm755 bin/rrserver debian/rustyrig-server/usr/bin/rrserver
ifneq ($(filter yes true 1,$(WITH_FT8)),)
	install -Dm755 modems/ft8/rrmodem-ft8 debian/rustyrig-modem-ft8/var/lib/rustyrig/modems/rrmodem-ft8
endif
	install -Dm755 bin/rr-si5351 debian/rustyrig-server/usr/bin/rr-si5351
	install -Dm755 bin/rrserver-gps-nmea.so debian/rustyrig-server/usr/lib/rustyrig/modules/rrserver/rrserver-gps-nmea.so
	install -Dm755 bin/rrserver-gpsd.so debian/rustyrig-server-gpsd/usr/lib/rustyrig/modules/rrserver/rrserver-gpsd.so
	install -Dm755 bin/rrclient debian/rustyrig-client/usr/bin/rrclient
	install -Dm755 bin/rrclient-gtk.so debian/rustyrig-client-gtk/usr/lib/rustyrig/modules/rrclient/rrclient-gtk.so
	install -Dm644 packaging/rustyrig-client.desktop debian/rustyrig-client-gtk/usr/share/applications/rustyrig-client.desktop
	install -Dm644 res/rustyrig.png debian/rustyrig-client-gtk/usr/share/icons/hicolor/48x48/apps/rustyrig.png
	install -Dm755 bin/fwdsp debian/rustyrig-fwdsp/usr/bin/fwdsp
	install -Dm755 bin/callsign-lookup debian/rustyrig-callsign-lookup/usr/bin/callsign-lookup
	install -Dm644 config/callsign-lookup.cfg debian/rustyrig-callsign-lookup/etc/rustyrig/callsign-lookup.cfg
	install -Dm755 tools/rr-get-audit-log debian/rustyrig-server/usr/bin/rr-get-audit-log
	install -Dm755 tools/rr-get-chat-log debian/rustyrig-server/usr/bin/rr-get-chat-log
	install -Dm755 tools/rr-get-ptt-log debian/rustyrig-server/usr/bin/rr-get-ptt-log
	install -d -m0775 debian/rustyrig-server/var/lib/rustyrig/db
	install -d -m0775 debian/rustyrig-server/var/lib/rustyrig/recordings
	install -d -m0775 debian/rustyrig-server/var/lib/rustyrig/modems
	install -d debian/rustyrig-server/var/lib/rustyrig/sql
	install -d debian/rustyrig-server/var/lib/rustyrig/www
	install -d debian/rustyrig-server/var/lib/rustyrig/tools
	install -d debian/rustyrig-server/var/run/rustyrig
	install -d -m0775 debian/rustyrig-server/var/log/rustyrig
	install -Dm644 packaging/rustyrig.tmpfiles debian/rustyrig-server/usr/lib/tmpfiles.d/rustyrig.conf
	cat debian/rustyrig.tmpfiles-acl >> debian/rustyrig-server/usr/lib/tmpfiles.d/rustyrig.conf
	install -Dm644 packaging/rrserver.service debian/rustyrig-server/usr/lib/systemd/system/rustyrig-server.service
	install -d -m0775 debian/rustyrig-client/var/lib/rustyrig/db
	install -d debian/rustyrig-client/var/lib/rustyrig/help
	install -d -m0775 debian/rustyrig-client/var/lib/rustyrig/recordings/client
	install -d -m0775 debian/rustyrig-client/var/log/rustyrig
	install -d debian/rustyrig-client/var/run/rustyrig
	install -d debian/rustyrig-client-gtk/usr/lib/rustyrig/modules/rrclient
	install -d debian/rustyrig-server/etc/rustyrig
	install -d debian/rustyrig-client/etc/rustyrig
	# Install the root config and all include fragments as dpkg conffiles.
	# Keep user edits during upgrades; never replace these in postinst.
	for cfg in config/rrserver.cfg config/rrserver.*.cfg; do \
		install -Dm644 "$$cfg" "debian/rustyrig-server/etc/rustyrig/$${cfg##*/}"; \
	done
	install -Dm644 config/$(PROFILE).config.json debian/rustyrig-server/etc/rustyrig/$(PROFILE).config.json
	# Removed: callsign lookup server settings now live in rrserver.callsign-lookup.cfg.
	install -Dm644 config/ua-bans debian/rustyrig-server/etc/rustyrig/ua-bans.txt
	install -Dm755 tools/dummy-rigctld.sh debian/rustyrig-server/var/lib/rustyrig/tools/dummy-rigctld.sh
	install -Dm644 config/rrclient.cfg debian/rustyrig-client/etc/rustyrig/rrclient.cfg
	install -Dm644 config/callsign-lookup.cli.cfg debian/rustyrig-client/etc/rustyrig/callsign-lookup.cli.cfg
	find help -mindepth 1 -maxdepth 1 ! -name .git -exec cp -a {} debian/rustyrig-client/var/lib/rustyrig/help/ \;
	find www -mindepth 1 -maxdepth 1 ! -name .git -exec cp -a {} debian/rustyrig-server/var/lib/rustyrig/www/ \;
	find help -mindepth 1 -maxdepth 1 ! -name .git -exec cp -a {} debian/rustyrig-client/var/lib/rustyrig/help/ \;
	install -Dm644 sql/sqlite.master.sql debian/rustyrig-server/var/lib/rustyrig/sql/sqlite.master.sql
	install -Dm644 sql/sqlite.master.preload.sql debian/rustyrig-server/var/lib/rustyrig/sql/sqlite.master.preload.sql

	install -Dm755 librustyaxe.so debian/librustyaxe/usr/lib/$(DEB_HOST_MULTIARCH)/librustyaxe.so.0
	install -Dm755 librrprotocol.so debian/librrprotocol/usr/lib/$(DEB_HOST_MULTIARCH)/librrprotocol.so.0
	install -Dm755 libfwdspmgr.so debian/libfwdspmgr/usr/lib/$(DEB_HOST_MULTIARCH)/libfwdspmgr.so.0
	install -d debian/librustyaxe-dev/usr/lib/$(DEB_HOST_MULTIARCH)
	install -d debian/librrprotocol-dev/usr/lib/$(DEB_HOST_MULTIARCH)
	install -d debian/libfwdspmgr-dev/usr/lib/$(DEB_HOST_MULTIARCH)
	ln -sf librustyaxe.so.0 debian/librustyaxe-dev/usr/lib/$(DEB_HOST_MULTIARCH)/librustyaxe.so
	ln -sf librrprotocol.so.0 debian/librrprotocol-dev/usr/lib/$(DEB_HOST_MULTIARCH)/librrprotocol.so
	ln -sf libfwdspmgr.so.0 debian/libfwdspmgr-dev/usr/lib/$(DEB_HOST_MULTIARCH)/libfwdspmgr.so

	install -d debian/librustyaxe-dev/usr/include/librustyaxe
	cp -a librustyaxe/*.h debian/librustyaxe-dev/usr/include/librustyaxe/
	install -d debian/librrprotocol-dev/usr/include/librrprotocol
	cp -a librrprotocol/*.h debian/librrprotocol-dev/usr/include/librrprotocol/
	install -d debian/libfwdspmgr-dev/usr/include/libfwdspmgr
	cp -a libfwdspmgr/*.h debian/libfwdspmgr-dev/usr/include/libfwdspmgr/

	install -d debian/rustyrig-server/usr/share/doc/rustyrig/config
	cp -a config/rrserver.cfg config/rrserver.*.cfg config/rrclient.cfg config/callsign-lookup.cfg config/callsign-lookup.cli.cfg config/ua-bans debian/rustyrig-server/usr/share/doc/rustyrig/config/
	cp -a doc debian/rustyrig-server/usr/share/doc/rustyrig/

override_dh_installinit:
	dh_installinit --name=rrserver -p rustyrig-server

override_dh_installdeb:
	dh_installdeb $(OPTIONAL_DH_EXCLUDES) $(FT8_DH_EXCLUDE)
	# dh_installdeb combines package preinst scripts with .maintscript migrations.
	# Do not overwrite its generated preinst: that would disable rm_conffile.
