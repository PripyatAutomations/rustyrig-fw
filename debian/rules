#!/usr/bin/make -f

export DH_VERBOSE = 1
.DEFAULT_GOAL := binary
PROFILE ?= rrserver
CLIENT_PROFILE ?= rrclient
include mk/optional-modules.mk
include mk/install-paths.mk

# FT8 is optional: external ft8_lib is only needed for this binary package.
WITH_FT8 ?= no
FT8_DH_EXCLUDE := $(if $(filter yes true 1,$(WITH_FT8)),,-Nrustyrig-modem-ft8)

# Optional packages are omitted consistently at every debhelper stage.
define optional_install_rule
.PHONY: install-optional-$(1)
install-optional-$(1):
	install -Dm755 $(OPTIONAL_$(1)_ARTIFACT) debian/$(OPTIONAL_$(1)_PACKAGE)/$(OPTIONAL_$(1)_DEST)
endef
$(foreach m,$(ENABLED_OPTIONAL_MODULES),$(eval $(call optional_install_rule,$(m))))

# dpkg-buildpackage exposes requested parallelism as parallel=N.  Direct
# debian/rules invocations remain serial unless that option is supplied.
DEB_BUILD_JOBS = 1
parallel_opt := $(filter parallel=%,$(DEB_BUILD_OPTIONS))
ifneq ($(parallel_opt),)
DEB_BUILD_JOBS = $(patsubst parallel=%,%,$(parallel_opt))
ifeq ($(DEB_BUILD_JOBS),auto)
DEB_BUILD_JOBS = $(shell nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
endif
endif

%:
	dh $@ $(OPTIONAL_DH_EXCLUDES) $(FT8_DH_EXCLUDE)

# Keep package builds independent of the optional hardware/integration test suite.
override_dh_auto_test:
	:

override_dh_auto_clean:
	$(MAKE) distclean || true
	$(MAKE) -C gmatrix clean || true
	$(MAKE) -C modems/ft8 clean || true

override_dh_auto_build:
	@echo "Optional modules enabled: $(ENABLED_OPTIONAL_MODULES); skipped: $(DISABLED_OPTIONAL_MODULES)"
	# Binary destinations are shared; force outputs to match their profile even
	# when packaging follows a prior developer build of a different profile.
	rm -f bin/rrserver bin/rrserver-gps-nmea.so bin/rrserver-gpsd.so bin/rrserver-hamlib.so bin/rr-dds-si5351 bin/fwdsp bin/rrbridge bin/rrbridge-kiwi.so libfwdspmgr.so
	# Compile server-side binaries and shared helpers with their own profile.
	$(MAKE) -j$(DEB_BUILD_JOBS) PROFILE=$(PROFILE) $(OPTIONAL_MAKE_FLAGS)
	# Executables live in bin/, not build/PROFILE: prevent cross-profile reuse.
	rm -f bin/rrclient bin/rrclient-gtk.so bin/rrpipelines gmatrix/gmatrix
	$(MAKE) -j$(DEB_BUILD_JOBS) PROFILE=$(CLIENT_PROFILE) WITH_HAMLIB=no
ifneq ($(filter yes true 1,$(WITH_FT8)),)
	$(MAKE) -C modems/ft8 FT8_LIB=../../ext/ft8_lib
endif

override_dh_auto_install: $(addprefix install-optional-,$(ENABLED_OPTIONAL_MODULES))
	install -Dm755 packaging/admin-permissions.sh debian/rustyrig-common/usr/lib/rustyrig/admin-permissions
	install -Dm755 bin/rrbridge debian/rustyrig-rrbridge$(BINDIR)/rrbridge
	install -Dm755 bin/rrbridge-kiwi.so debian/rustyrig-rrbridge$(MODULEDIR)/rrbridge/rrbridge-kiwi.so
	install -Dm755 bin/rrserver debian/rustyrig-server$(BINDIR)/rrserver
	install -Dm755 bin/rr-password-hash debian/rustyrig-server/usr/lib/rustyrig/rr-password-hash
ifneq ($(filter yes true 1,$(WITH_FT8)),)
	install -Dm755 modems/ft8/rrmodem-ft8 debian/rustyrig-modem-ft8/var/lib/rustyrig/modems/rrmodem-ft8
endif
	install -Dm755 bin/rr-dds-si5351 debian/rustyrig-server$(BINDIR)/rr-dds-si5351
	install -Dm755 bin/rrserver-gps-nmea.so debian/rustyrig-server$(MODULEDIR)/rrserver/rrserver-gps-nmea.so
	install -Dm755 bin/rrserver-gpsd.so debian/rustyrig-server-gpsd$(MODULEDIR)/rrserver/rrserver-gpsd.so
	install -Dm755 bin/rrclient debian/rustyrig-client$(BINDIR)/rrclient
	install -Dm755 bin/rrclient-gtk.so debian/rustyrig-client-gtk$(MODULEDIR)/rrclient/rrclient-gtk.so
	install -Dm755 bin/rrpipelines debian/rustyrig-client-gtk$(BINDIR)/rrpipelines
	$(MAKE) -C gmatrix -f debian/package.mk install DEB_DESTDIR=../debian/gmatrix
	install -Dm644 packaging/rustyrig-client.desktop debian/rustyrig-client-gtk/usr/share/applications/rustyrig-client.desktop
	install -Dm644 res/rustyrig.png debian/rustyrig-client-gtk/usr/share/icons/hicolor/48x48/apps/rustyrig.png
	install -Dm755 bin/fwdsp debian/rustyrig-fwdsp$(BINDIR)/fwdsp
	install -Dm755 tools/rr-get-audit-log debian/rustyrig-server$(BINDIR)/rr-get-audit-log
	install -Dm755 tools/rr-get-chat-log debian/rustyrig-server$(BINDIR)/rr-get-chat-log
	install -Dm755 tools/rr-get-ptt-log debian/rustyrig-server$(BINDIR)/rr-get-ptt-log
	# Private Ed25519 identity directory; keys are runtime state, never packaged.
	install -d -m0700 debian/rustyrig-server/var/lib/rustyrig/identity
	install -d -m0775 debian/rustyrig-server/var/lib/rustyrig/db
	install -d -m0775 debian/rustyrig-server/var/lib/rustyrig/recordings
	install -d -m0775 debian/rustyrig-server/var/lib/rustyrig/modems
	install -d debian/rustyrig-server/var/lib/rustyrig/sql
	install -d debian/rustyrig-server/var/lib/rustyrig/www
	install -d debian/rustyrig-server/var/lib/rustyrig/tools
	install -d debian/rustyrig-server/var/run/rustyrig
	install -d -m0775 debian/rustyrig-server/var/log/rustyrig
	install -Dm644 packaging/rustyrig.tmpfiles debian/rustyrig-server/usr/lib/tmpfiles.d/rustyrig.conf
	cat debian/rustyrig.tmpfiles-acl >> debian/rustyrig-server/usr/lib/tmpfiles.d/rustyrig.conf
	install -Dm644 packaging/rrserver.service debian/rustyrig-server/usr/lib/systemd/system/rustyrig-server.service
	install -d -m0775 debian/rustyrig-client/var/lib/rustyrig/db
	install -d debian/rustyrig-client/var/lib/rustyrig/help
	install -d -m0775 debian/rustyrig-client/var/lib/rustyrig/recordings/client
	install -d -m0775 debian/rustyrig-client/var/log/rustyrig
	install -d debian/rustyrig-client/var/run/rustyrig
	install -d debian/rustyrig-client-gtk$(MODULEDIR)/rrclient
	install -d debian/rustyrig-server/etc/rustyrig
	install -d debian/rustyrig-client/etc/rustyrig
	# Install only the selected server profile's channel memories, using
	# radio.channels.json as the reference default when no override exists.
	# Do not manufacture rrserver.channels.json or rrclient.channels.json.
	@if test -f "config/$(PROFILE).channels.json"; then \
		channels="config/$(PROFILE).channels.json"; \
	else \
		channels="config/radio.channels.json"; \
	fi; \
	if test ! -f "$channels"; then \
		echo "Missing channel memory configuration: $channels" >&2; exit 1; \
	fi; \
	install -Dm644 "$channels" debian/rustyrig-server$(CONF_DIR)/channels.json

	# Package .cfg and .md plus the selected profile's channels.json above.
	for cfg in config/*.cfg config/*.md; do \
		[ -f "$$cfg" ] || continue; \
		case "$${cfg##*/}" in callsign-lookup.cfg) continue ;; rrclient*) pkg=rustyrig-client ;; *) pkg=rustyrig-server ;; esac; \
		install -Dm644 "$$cfg" "debian/$$pkg$(CONF_DIR)/$${cfg##*/}"; \
	done
	install -Dm644 config/ua-bans debian/rustyrig-server$(CONF_DIR)/ua-bans
	install -Dm755 tools/dummy-rigctld.sh debian/rustyrig-server/var/lib/rustyrig/tools/dummy-rigctld.sh
	# Generated CSS is not a config/ source file.
	perl tools/releng-dump-css.pl --css > debian/rustyrig-client$(CONF_DIR)/rrclient.css
	chmod 644 debian/rustyrig-client$(CONF_DIR)/rrclient.css
	find help -mindepth 1 -maxdepth 1 ! -name .git -exec cp -a {} debian/rustyrig-client/var/lib/rustyrig/help/ \;
	# The in-tree web UI was removed; do not attempt to stage a nonexistent www/ tree.
	install -Dm644 sql/sqlite.master.sql debian/rustyrig-server/var/lib/rustyrig/sql/sqlite.master.sql
	install -Dm644 sql/sqlite.master.preload.sql debian/rustyrig-server/var/lib/rustyrig/sql/sqlite.master.preload.sql

	# fwdsp and its manager shared library are one binary package.
	install -Dm755 libfwdspmgr.so debian/rustyrig-fwdsp$(LIBDIR)/libfwdspmgr.so.0
	ln -sf libfwdspmgr.so.0 debian/rustyrig-fwdsp$(LIBDIR)/libfwdspmgr.so
	install -d debian/rustyrig-fwdsp/usr/include/libfwdspmgr
	cp -a libfwdspmgr/*.h debian/rustyrig-fwdsp/usr/include/libfwdspmgr/

	install -d debian/rustyrig-server/usr/share/doc/rustyrig/config
	for cfg in config/*.cfg config/*.md; do \
		[ -f "$cfg" ] && cp -a "$cfg" debian/rustyrig-server/usr/share/doc/rustyrig/config/ || true; \
	done
	install -Dm644 config/ua-bans debian/rustyrig-server/usr/share/doc/rustyrig/config/ua-bans
	cp -a doc debian/rustyrig-server/usr/share/doc/rustyrig/

# Installing RustyRig must never start or enable rrserver without an
# administrator's explicit choice. Do not interrupt running radio sessions
# during package upgrades, either. These flags apply to both SysV-style
# init integration and systemd installations.
override_dh_installinit:
	dh_installinit --name=rrserver -p rustyrig-server --no-enable --no-start --no-stop-on-upgrade

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade

override_dh_installdeb:
	dh_installdeb $(OPTIONAL_DH_EXCLUDES) $(FT8_DH_EXCLUDE)
	# dh_installdeb combines package preinst scripts with .maintscript migrations.
	# Do not overwrite its generated preinst: that would disable rm_conffile.
