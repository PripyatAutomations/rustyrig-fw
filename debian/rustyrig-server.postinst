#!/bin/sh
set -e


for dir in /var/lib/rustyrig/db /var/lib/rustyrig/recordings /var/lib/rustyrig/modems /var/log/rustyrig; do
    install -d -o rustyrig -g rustyrig -m 0770 "$dir"
done
# Exported shared storage; preserve an existing directory's permissions.
if [ ! -d /home/rustyrig/SHARED ]; then
    install -d -o rustyrig -g rustyrig -m 0770 /home/rustyrig/SHARED
fi
install -d -o rustyrig-modems -g rustyrig-modems -m 0770 /var/lib/rustyrig/modems
install -d -o rustyrig -g rustyrig -m 0770 /var/run/rustyrig
# Mesh identity files are durable trust anchors. Never recreate them on upgrade.
# rr_identity_init rejects a directory writable/readable by group or others.
# Restrict the directory itself without touching existing private keys.
install -d -o rustyrig -g rustyrig -m 0700 /var/lib/rustyrig/identity

# The preload SQL contains a disabled admin placeholder with an empty password.
# Enable it with the chosen password before the service can start. Existing
# databases are never reset during upgrades.
if [ -r /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
fi

admin_password=
guest_enabled=false
guest_password=
remote_admin_enabled=false
remote_admin_subjects=
if command -v db_get >/dev/null 2>&1; then
    db_get rustyrig-server/admin-password || true
    admin_password=${RET:-}
    if db_get rustyrig-server/enable-guest; then
        guest_enabled=${RET:-false}
    fi
    if [ "$guest_enabled" = true ] && db_get rustyrig-server/guest-password; then
        guest_password=${RET:-}
    fi
    if db_get rustyrig-server/allow-remote-admin; then
        remote_admin_enabled=${RET:-false}
    fi
    if [ "$remote_admin_enabled" = true ] && db_get rustyrig-server/remote-admin-subjects; then
        remote_admin_subjects=${RET:-}
    fi
fi

master_db=/var/lib/rustyrig/db/master.db
master_sql=/var/lib/rustyrig/sql/sqlite.master.sql
preload_sql=/var/lib/rustyrig/sql/sqlite.master.preload.sql
new_database=false

if [ ! -e "$master_db" ]; then
    if [ -z "$admin_password" ]; then
        echo "rustyrig-server: an admin password is required for a new installation" >&2
        exit 1
    fi
    if [ "$guest_enabled" = true ] && [ -z "$guest_password" ]; then
        echo "rustyrig-server: guest account requires an explicit password" >&2
        exit 1
    fi
    if [ "$remote_admin_enabled" = true ]; then
        printf '%s' "$remote_admin_subjects" |
            /usr/lib/rustyrig/seed-remote-admin --check
    fi
    # Complete bootstrap privately. A failed statement or hash helper must
    # not leave master.db looking like an existing, initialized installation.
    bootstrap_db=$(mktemp "$master_db.new.XXXXXX")
    trap 'rm -f -- "$bootstrap_db" "$bootstrap_db-journal" "$bootstrap_db-wal" "$bootstrap_db-shm"' 0
    trap 'exit 1' HUP INT TERM
    sqlite3 -bail "$bootstrap_db" < "$master_sql"
    sqlite3 -bail "$bootstrap_db" < "$preload_sql"

    # A grant names a future authenticated user@origin-site. It does not
    # create the account or enroll, pin, or trust a remote server certificate.
    if [ "$remote_admin_enabled" = true ]; then
        printf '%s' "$remote_admin_subjects" |
            /usr/lib/rustyrig/seed-remote-admin "$bootstrap_db"
    fi

    # Keep the cleartext password out of argv and command output.
    admin_hash=$(printf '%s' "$admin_password" | /usr/lib/rustyrig/rrhashpass)
    [ -n "$admin_hash" ] || { echo "rustyrig-server: empty admin password verifier" >&2; exit 1; }
    sqlite3 -bail "$bootstrap_db" \
        "UPDATE users SET enabled=1,password='$admin_hash' WHERE name='admin';"
    if [ "$guest_enabled" = true ]; then
        guest_hash=$(printf '%s' "$guest_password" | /usr/lib/rustyrig/rrhashpass)
        [ -n "$guest_hash" ] || { echo "rustyrig-server: empty guest password verifier" >&2; exit 1; }
        sqlite3 -bail "$bootstrap_db" \
            "UPDATE users SET enabled=1,password='$guest_hash',permissions='rx,chat' WHERE name='guest';"
    fi
    # All SQLite connections have closed. Publish without replacing an
    # existing database, including one created concurrently.
    chown rustyrig:rustyrig "$bootstrap_db"
    chmod 0660 "$bootstrap_db"
    ln -T -- "$bootstrap_db" "$master_db"
    rm -f -- "$bootstrap_db" "$bootstrap_db-journal" "$bootstrap_db-wal" "$bootstrap_db-shm"
    trap - 0 HUP INT TERM
    new_database=true
fi

if command -v db_set >/dev/null 2>&1 && [ "$new_database" = true ]; then
    # Do not retain the cleartext password in the debconf database.
    db_set rustyrig-server/admin-password "" || true
    db_set rustyrig-server/guest-password "" || true
fi

# Apply only pending debconf edits, never stale answers on ordinary upgrades.
if command -v db_get >/dev/null 2>&1 && db_get rustyrig-server/site-pending && [ "${RET:-false}" = true ]; then
    db_get rustyrig-server/site-call
    site_call=${RET:-}
    db_get rustyrig-server/site-grid
    site_grid=${RET:-}
    db_get rustyrig-server/site-location
    site_location=${RET:-}
    db_get rustyrig-server/site-description
    site_description=${RET:-}
    db_get rustyrig-server/site-domain
    site_domain=${RET:-}
    db_get rustyrig-server/site-name
    site_name=${RET:-}
    /usr/lib/rustyrig/configure-site /etc/rustyrig/rrserver.site-local.cfg \
        "$site_call" "$site_grid" "$site_location" "$site_description" "$site_domain" "$site_name"
    db_set rustyrig-server/site-pending false || true
fi

# Grant administrative access without changing service ownership.
/usr/lib/rustyrig/admin-permissions

# Recover preexisting installations where older admin-permissions recursively
# granted rradmin/group ACLs to private signing/TLS identities. These files
# are durable mesh trust anchors: change permissions, never replace content.
identity=/var/lib/rustyrig/identity
if [ -d "$identity" ] && [ ! -L "$identity" ]; then
    chown rustyrig:rustyrig "$identity"
    setfacl -b -k "$identity"
    chmod 0700 "$identity"
    for private in server-ed25519.pem tls-key.pem; do
        if [ -f "$identity/$private" ] && [ ! -L "$identity/$private" ]; then
            chown rustyrig:rustyrig "$identity/$private"
            setfacl -b "$identity/$private"
            chmod 0600 "$identity/$private"
        fi
    done
    if [ -f "$identity/tls-cert.pem" ] && [ ! -L "$identity/tls-cert.pem" ]; then
        chown rustyrig:rustyrig "$identity/tls-cert.pem"
        setfacl -b "$identity/tls-cert.pem"
        chmod 0644 "$identity/tls-cert.pem"
    fi
fi
if [ -r /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
fi
if command -v db_get >/dev/null 2>&1 && db_get rustyrig/admin-users; then
    for user in ${RET:-}; do
        case "$user" in
            -*|*[!a-zA-Z0-9_.-]*) echo "rustyrig: skipping invalid local username: $user" >&2; continue ;;
        esac
        if ! getent passwd "$user" >/dev/null; then
            echo "rustyrig: skipping unknown local user: $user" >&2
            continue
        fi
        adduser "$user" rradmin
    done
fi
# Grant virtual serial access separately from administrative access.
if command -v db_get >/dev/null 2>&1 && db_get rustyrig/serial-users; then
    for user in ${RET:-}; do
        case "$user" in
            -*|*[!a-zA-Z0-9_.-]*) echo "rustyrig: skipping invalid local username: $user" >&2; continue ;;
        esac
        if ! getent passwd "$user" >/dev/null; then
            echo "rustyrig: skipping unknown local user: $user" >&2
            continue
        fi
        adduser "$user" rruser
    done
fi
#DEBHELPER#
exit 0
