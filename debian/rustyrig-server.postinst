#!/bin/sh
set -e

if ! getent group rustyrig >/dev/null; then
    addgroup --system rustyrig
fi
if ! getent passwd rustyrig >/dev/null; then
    adduser --system --ingroup rustyrig --home /var/lib/rustyrig \
        --no-create-home --shell /usr/sbin/nologin rustyrig
fi
if ! getent group rustyrig-modems >/dev/null; then
    addgroup --system rustyrig-modems
fi
if ! getent passwd rustyrig-modems >/dev/null; then
    adduser --system --ingroup rustyrig-modems --home /var/lib/rustyrig \
        --no-create-home --shell /usr/sbin/nologin rustyrig-modems
fi

for dir in /var/lib/rustyrig/db /var/lib/rustyrig/recordings /var/lib/rustyrig/modems /var/log/rustyrig; do
    install -d -o rustyrig -g rustyrig -m 0770 "$dir"
done
install -d -o rustyrig-modems -g rustyrig-modems -m 0770 /var/lib/rustyrig/modems
install -d -o rustyrig -g rustyrig -m 0770 /var/run/rustyrig

# The preload SQL contains a disabled admin placeholder with an empty password.
# Enable it with the chosen password before the service can start. Existing
# databases are never reset during upgrades.
if [ -r /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
fi

admin_password=
guest_enabled=false
if command -v db_get >/dev/null 2>&1; then
    db_get rustyrig-server/admin-password || true
    admin_password=${RET:-}
    if db_get rustyrig-server/enable-guest; then
        guest_enabled=${RET:-false}
    fi
fi

master_db=/var/lib/rustyrig/db/master.db
master_sql=/var/lib/rustyrig/sql/sqlite.master.sql
preload_sql=/var/lib/rustyrig/sql/sqlite.master.preload.sql
new_database=false

if [ ! -e "$master_db" ]; then
    if [ -z "$admin_password" ]; then
        echo "rustyrig-server: an admin password is required for a new installation" >&2
        exit 1
    fi
    sqlite3 "$master_db" < "$master_sql"
    sqlite3 "$master_db" < "$preload_sql"
    new_database=true
fi

if [ "$new_database" = true ]; then
    # hash_passwd() uses SHA-1 for the existing wire-auth database format.
    admin_hash=$(printf '%s' "$admin_password" | sha1sum | cut -d ' ' -f 1)
    sqlite3 "$master_db" \
        "UPDATE users SET enabled=1,password='$admin_hash' WHERE name='admin';"
    if [ "$guest_enabled" = true ]; then
        guest_hash=$(printf '%s' guest | sha1sum | cut -d ' ' -f 1)
        sqlite3 "$master_db" \
            "UPDATE users SET enabled=1,password='$guest_hash',permissions='rx,chat' WHERE name='guest';"
    fi
    chown rustyrig:rustyrig "$master_db"
    chmod 0660 "$master_db"
fi

if command -v db_purge >/dev/null 2>&1 && [ "$new_database" = true ]; then
    # Do not retain the cleartext password in the debconf database.
    db_purge rustyrig-server/admin-password || true
fi

exit 0
