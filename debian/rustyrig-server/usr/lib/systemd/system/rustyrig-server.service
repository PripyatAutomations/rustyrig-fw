[Unit]
Description=RustyRig radio server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=rustyrig
Group=rustyrig
WorkingDirectory=/var/lib/rustyrig
ExecStart=/usr/bin/rrserver -f /etc/rustyrig/rrserver.cfg
Restart=on-failure
RestartSec=5s
RuntimeDirectory=rustyrig
UMask=0007

[Install]
WantedBy=multi-user.target
