#!/bin/sh
set -e


for dir in /var/lib/rustyrig/db /var/lib/rustyrig/recordings/client /var/log/rustyrig /var/run/rustyrig; do
    install -d -o rustyrig -g rustyrig -m 0770 "$dir"
done

# Grant administrative access without changing service ownership.
/usr/lib/rustyrig/admin-permissions
if [ -r /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
fi
if command -v db_get >/dev/null 2>&1 && db_get rustyrig/admin-users; then
    for user in ${RET:-}; do
        case "$user" in
            -*|*[!a-zA-Z0-9_.-]*) echo "Invalid local username: $user" >&2; exit 1 ;;
        esac
        if ! getent passwd "$user" >/dev/null; then
            echo "Unknown local user: $user" >&2
            exit 1
        fi
        adduser "$user" rradmin
    done
fi
exit 0
