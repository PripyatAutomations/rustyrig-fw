index 0000000..a508eff
--- /dev/null
+++ b/rrserver/cfg.bridge.h
@@ -0,0 +1,7 @@
+// rrserver/cfg.bridge.h: named bridge configuration.
+#ifndef RRSERVER_CFG_BRIDGE_H
+#define RRSERVER_CFG_BRIDGE_H
+#include <stdbool.h>
+bool rrserver_bridge_config_init(void);
+const char *rrserver_bridge_config_get(const char *name, const char *key);
+#endif
diff --git a/rrserver/cfg.bridge.c b/rrserver/cfg.bridge.c
new file mode 100644
index 0000000..011e7b3
--- /dev/null
+++ b/rrserver/cfg.bridge.c
@@ -0,0 +1,61 @@
+// Named SDR subprocess configuration sections.
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <librustyaxe/core.h>
+#include <rrserver/cfg.bridge.h>
+
+static bool valid_name(const char *s) {
+   if (!s || !*s) return false;
+   for (; *s; s++)
+      if (!isalnum((unsigned char)*s) && *s != '_' && *s != '-') return false;
+   return true;
+}
+
+static bool section_cb(const char *path, int line, const char *section, const char *buf) {
+   if (!section || !buf) return true;
+   const char *name = NULL;
+   if (!strcmp(section, "bridge")) name = NULL;
+   else if (!strncmp(section, "bridge:", 7) && valid_name(section + 7)) name = section + 7;
+   else return true;
+   char *copy = strdup(buf);
+   if (!copy) return true;
+   char *value = strchr(copy, '=');
+   if (!value) { free(copy); return true; }
+   *value++ = '\0';
+   char *key = copy;
+   while (isspace((unsigned char)*key)) key++;
+   while (isspace((unsigned char)*value)) value++;
+   char *end = key + strlen(key);
+   while (end > key && isspace((unsigned char)end[-1])) *--end = '\0';
+   end = value + strlen(value);
+   while (end > value && isspace((unsigned char)end[-1])) *--end = '\0';
+   /* [bridge] defines the roster and process path; named sections carry per-device parameters.
+    * Preserve unknown named keys to allow driver-specific settings. */
+   bool key_valid = *key && strlen(key) <= 63;
+   for (const char *c = key; *c; c++)
+      if (!isalnum((unsigned char)*c) && *c != '_' && *c != '-' && *c != '.') key_valid = false;
+   if (!key_valid || (!name && strcmp(key, "instances") && strcmp(key, "path"))) {
+      Log(LOG_CRIT, "cfg.bridge", "Invalid key in [%s] at %s:%d", section, path, line);
+      free(copy);
+      return true;
+   }
+   char fullkey[256];
+   int n = name ? snprintf(fullkey, sizeof(fullkey), "bridge:%s.%s", name, key)
+                : snprintf(fullkey, sizeof(fullkey), "bridge.%s", key);
+   bool ok = n > 0 && (size_t)n < sizeof(fullkey) && dict_add(cfg, fullkey, value) == 0;
+   free(copy);
+   return !ok;
+}
+
+bool rrserver_bridge_config_init(void) {
+   return cfg_add_callback(NULL, "bridge", section_cb) && cfg_add_callback(NULL, "bridge:*", section_cb);
+}
+
+const char *rrserver_bridge_config_get(const char *name, const char *key) {
+   if (!valid_name(name) || !key || !*key || strlen(key) > 63) return NULL;
+   char fullkey[256];
+   int n = snprintf(fullkey, sizeof(fullkey), "bridge:%s.%s", name, key);
+   return n > 0 && (size_t)n < sizeof(fullkey) ? cfg_get(fullkey) : NULL;
+}
diff --git a/rrserver/bridge.manager.h b/rrserver/bridge.manager.h
new file mode 100644
index 0000000..b9cef0b
--- /dev/null
+++ b/rrserver/bridge.manager.h
@@ -0,0 +1,8 @@
+// Server-owned external SDR bridge subprocess lifecycle.
+#ifndef RRSERVER_BRIDGE_MANAGER_H
+#define RRSERVER_BRIDGE_MANAGER_H
+#include <stdbool.h>
+bool rrserver_bridges_start(const char *config_file);
+void rrserver_bridges_poll(void);
+void rrserver_bridges_stop(void);
+#endif
diff --git a/rrserver/bridge.manager.c b/rrserver/bridge.manager.c
new file mode 100644
index 0000000..04b8be2
--- /dev/null
+++ b/rrserver/bridge.manager.c
@@ -0,0 +1,98 @@
+// One supervised rrbridge child for each configured SDR endpoint.
+#include <ctype.h>
+#include <signal.h>
+#include <strings.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <librustyaxe/core.h>
+#include <librustyaxe/subproc.h>
+#include <rrserver/cfg.bridge.h>
+#include <rrserver/bridge.manager.h>
+
+struct bridge_child {
+   char *name;
+   subproc_t process;
+   time_t next_retry;
+   unsigned failures;
+   struct bridge_child *next;
+};
+static struct bridge_child *children;
+static char *config_path;
+
+static bool spawn_child(struct bridge_child *b) {
+   const char *path = cfg_get("bridge.path");
+   if (!path || !*path) path = "bin/rrbridge";
+   const char *argv[] = { path, "--config", config_path, "--bridge", b->name, NULL };
+   /* Do not expose receiver credentials on the process command line. */
+   bool ok = subproc_spawn_fds(&b->process, path, argv, NULL, 0, NULL, 0);
+   if (ok) Log(LOG_INFO, "bridge", "Spawned [%s] pid=%ld", b->name, (long)b->process.pid);
+   else Log(LOG_WARN, "bridge", "Could not spawn [%s] using %s", b->name, path);
+   return ok;
+}
+
+static void schedule_retry(struct bridge_child *b) {
+   unsigned delay = 1U << (b->failures < 6 ? b->failures : 6);
+   if (b->failures < 6) b->failures++;
+   b->next_retry = time(NULL) + (time_t)delay;
+}
+
+bool rrserver_bridges_start(const char *file) {
+   if (children || config_path) return false;
+   const char *instances = cfg_get("bridge.instances");
+   if (!instances || !*instances) return true;
+   if (!file || !(config_path = strdup(file))) return false;
+   char *names = strdup(instances);
+   if (!names) { free(config_path); config_path = NULL; return false; }
+   bool ok = true;
+   char *save = NULL;
+   for (char *name = strtok_r(names, " ,\t\r\n", &save); name; name = strtok_r(NULL, " ,\t\r\n", &save)) {
+      const char *driver = rrserver_bridge_config_get(name, "driver");
+      const char *enabled = rrserver_bridge_config_get(name, "enabled");
+      if (enabled && (!strcasecmp(enabled, "false") || !strcmp(enabled, "0"))) continue;
+      if (!driver || !*driver) {
+         Log(LOG_CRIT, "bridge", "[%s] has no driver", name);
+         ok = false;
+         continue;
+      }
+      bool duplicate = false;
+      for (struct bridge_child *b = children; b; b = b->next)
+         if (!strcmp(b->name, name)) duplicate = true;
+      if (duplicate) { Log(LOG_WARN, "bridge", "Duplicate bridge name %s", name); ok = false; continue; }
+      struct bridge_child *b = calloc(1, sizeof(*b));
+      if (!b || !(b->name = strdup(name))) { free(b); ok = false; break; }
+      b->process = (subproc_t)SUBPROC_INIT;
+      b->next = children;
+      children = b;
+      if (!spawn_child(b)) schedule_retry(b);
+   }
+   free(names);
+   if (!ok) rrserver_bridges_stop();
+   return ok;
+}
+
+void rrserver_bridges_poll(void) {
+   time_t current = time(NULL);
+   for (struct bridge_child *b = children; b; b = b->next) {
+      int status;
+      if (b->process.pid > 0 && subproc_reap(&b->process, &status)) {
+         Log(LOG_WARN, "bridge", "Bridge [%s] exited (status=%d)", b->name, status);
+         subproc_close(&b->process);
+         schedule_retry(b);
+      }
+      if (b->process.pid <= 0 && current >= b->next_retry)
+         if (!spawn_child(b)) schedule_retry(b);
+   }
+}
+
+void rrserver_bridges_stop(void) {
+   while (children) {
+      struct bridge_child *b = children;
+      children = b->next;
+      subproc_stop(&b->process, SIGTERM);
+      free(b->name);
+      free(b);
+   }
+   free(config_path);
+   config_path = NULL;
+}
