[submodule "ext/wslay"]
	path = ext/wslay
	url = https://github.com/tatsuhiro-t/wslay.git
[submodule "ext/sqlite"]
	path = ext/sqlite
	url = https://github.com/sqlite/sqlite.git
[submodule "ext/mbedtls"]
	path = ext/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "ext/libmongoose"]
	path = ext/libmongoose
	url = https://github.com/cesanta/mongoose.git
[submodule "www"]
	path = www
	url = https://github.com/PripyatAutomations/rustyrig-www
[submodule "librustyaxe"]
	path = librustyaxe
	url = https://github.com/PripyatAutomations/librustyaxe
[submodule "librrprotocol"]
	path = librrprotocol
	url = https://github.com/PripyatAutomations/librrprotocol
[submodule "callsign-lookup"]
	path = callsign-lookup
	url = https://github.com/PripyatAutomations/callsign-lookup
[submodule "ext/--depth=1"]
	path = ext/codec2
	url = https://github.com/drowe67/codec2.git
[submodule "ext/wwvsim"]
	path = ext/wwvsim
	url = https://github.com/ka9q/wwvsim.git
[submodule "ext/libfec"]
	path = ext/libfec
	url = https://github.com/ka9q/libfec.git
[submodule "ext/chusim"]
	path = ext/chusim
	url = https://github.com/ka9q/chusim.git
